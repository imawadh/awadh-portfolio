---
interface Props {
  index?: string;
  category: string;
  note: string;
  skills: string[];
}

const { category, note, skills } = Astro.props;
---

<div class="grid gap-x-12 gap-y-4 border-t border-[var(--border-bright)] py-8 md:grid-cols-[5fr_7fr] md:py-10">
  <div>
    <h3 class="m-0 text-[1.7rem]">{category}</h3>
    <p class="m-0 mt-2 max-w-[36ch] text-[1rem] text-[var(--muted)]">{note}</p>
  </div>

  <ul class="skill-list m-0 flex flex-wrap content-start gap-x-1 gap-y-1">
    {skills.map((skill) => <li>{skill}</li>)}
  </ul>
</div>

<style>
  /* Skills read as a run of names, each in its own soft pill. */
  .skill-list li {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--fg);
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
  }
</style>
