---
interface Props {
  index?: string;
  category: string;
  note: string;
  skills: string[];
}

const { category, note, skills } = Astro.props;
---

<!-- A two-ended row: the group and what it is for on the left, the names
     themselves running across the right of the grid. -->
<div class="skill-row grid-12" data-rise>
  <div class="s-head">
    <h3>{category}</h3>
    <p class="small muted mt-1">{skills.length} items</p>
    <p class="muted mt-2 max-w-[36ch]">{note}</p>
  </div>
  <ul class="s-list">
    {skills.map((skill) => <li>{skill}</li>)}
  </ul>
</div>

<style>
  .skill-row {
    align-items: baseline;
    row-gap: 1rem;
  }
  .s-head {
    grid-column: 1 / span 4;
  }
  .s-list {
    grid-column: 6 / span 7;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
  }
  /* Names set in the lead size, separated by a comma rather than a pill. */
  .s-list li {
    font-size: var(--step-lead);
    line-height: 1.3;
    color: var(--ink);
  }
  .s-list li:not(:last-child)::after {
    content: ',';
    margin-right: 0.4em;
    color: var(--muted);
  }

  @media (max-width: 899px) {
    .s-head,
    .s-list {
      grid-column: 1 / -1;
    }
  }
</style>
