---
import { socials } from '../utils/socials';
import { resumeUrl } from '../utils/site';

const navItems = [
  { label: 'Work', href: '/projects' },
  { label: 'About', href: '/about' },
  { label: 'Experience', href: '/experience' },
  { label: 'Skills', href: '/skills' },
  { label: 'Credentials', href: '/certifications' },
  { label: 'Contact', href: '/contact' },
];

const email = 'awadhkishorsingh241@gmail.com';
const year = new Date().getFullYear();
// The contact page already leads with the email, so the footer skips its CTA there.
const showCta = !Astro.url.pathname.startsWith('/contact');
---

<footer class="on-brand mt-24 rounded-t-[28px] bg-[var(--bg)] md:mt-32 md:rounded-t-[40px]">
  <!-- CTA -->
  {showCta && (
  <div class="wrap pb-14 pt-16 md:pb-20 md:pt-24">
    <h2 class="footer-title max-w-[16ch]">Have something to build?</h2>
    <p class="mt-6 max-w-[52ch]">
      I&rsquo;m open to software engineering, full-stack and AI/ML roles, and to internships and
      freelance work. Email is the quickest way to reach me.
    </p>
    <a href={`mailto:${email}`} class="footer-email mt-8 inline-block break-all">{email}</a>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href="/contact" class="btn btn-primary">Get in touch</a>
      <a href={resumeUrl} target="_blank" rel="noopener noreferrer" class="btn">Download résumé</a>
    </div>
  </div>
  )}

  <!-- Colophon -->
  <div class:list={["wrap", !showCta && "pt-4"]}>
    <div class="grid gap-10 border-t border-[var(--border)] py-12 sm:grid-cols-2 md:grid-cols-[2fr_1fr_1fr]">
      <div class="sm:col-span-2 md:col-span-1">
        <p class="m-0 inline-flex items-center gap-2.5 text-[1rem] text-[var(--fg)] ui">
          <span class="pulse"></span>
          Open to internships and freelance work
        </p>
        <p class="mt-3 max-w-sm text-[0.98rem]">
          Full Stack AI Developer in Bengaluru. Data Science undergraduate at IIT Madras, building
          my first mobile app.
        </p>
      </div>

      <div>
        <p class="kicker mb-3">Pages</p>
        <ul class="flex flex-col gap-1.5">
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} class="foot-link">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="kicker mb-3">Elsewhere</p>
        <ul class="flex flex-col gap-1.5">
          {
            socials.map((social) => (
              <li>
                <a href={social.url} target="_blank" rel="noopener noreferrer" class="foot-link">
                  {social.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="flex flex-col gap-1 border-t border-[var(--border)] py-6 text-[0.88rem] text-[var(--muted)] sm:flex-row sm:items-center sm:justify-between"
    >
      <span>&copy; {year} Awadh Kishor Singh</span>
      <span>Set in Bricolage Grotesque and Newsreader</span>
    </div>
  </div>
</footer>

<style>
  .footer-title {
    font-size: clamp(2.6rem, 7vw, 5rem);
    font-weight: 700;
    font-variation-settings: 'wdth' 78;
    letter-spacing: -0.035em;
    line-height: 0.95;
  }
  .footer-email {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3.4vw, 2.1rem);
    font-weight: 560;
    letter-spacing: -0.02em;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.18em;
  }
  .footer-email:hover {
    text-decoration-thickness: 3px;
  }
  .foot-link {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--fg-dim);
    transition: color 0.2s ease;
  }
  .foot-link:hover {
    color: var(--accent);
  }
</style>
