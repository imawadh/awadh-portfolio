---
import { socials } from '../utils/socials';

const navItems = [
  { label: 'About', href: '/about' },
  { label: 'Experience', href: '/experience' },
  { label: 'Work', href: '/projects' },
  { label: 'Skills', href: '/skills' },
  { label: 'Credentials', href: '/certifications' },
  { label: 'Contact', href: '/contact' },
];

const email = 'awadhkishorsingh241@gmail.com';
const year = new Date().getFullYear();
---

<footer class="foot" aria-label="Site footer">
  <div class="wrap">
    <div class="foot-top" data-rise>
      <a href={`mailto:${email}`} class="foot-email">{email}</a>
      <a href="/contact" class="btn btn-primary">Say hello</a>
    </div>

    <div class="foot-grid grid-12">
      <p class="foot-statement small">
        Full Stack AI Developer building production-ready web applications from Bengaluru. Most
        recently Full Stack Developer Intern at IAVerse, a Data Science undergraduate at IIT Madras,
        and currently building my first mobile app.
      </p>

      <nav class="foot-nav" aria-label="Footer">
        <ul class="flex flex-col gap-1">
          {navItems.map((n) => <li><a href={n.href} class="foot-link small">{n.label}</a></li>)}
        </ul>
      </nav>

      <ul class="foot-social flex flex-col gap-1">
        {
          socials
            .filter((s) => s.icon !== 'mail')
            .map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer" class="foot-link small">
                  {s.label}
                </a>
              </li>
            ))
        }
      </ul>

      <div class="foot-time small">
        <p class="inline-flex items-center gap-2"><span class="pulse"></span>Open to internships &amp; freelance</p>
        <p class="muted mt-1">Bengaluru, India</p>
        <p class="figures mt-1"><time id="localTime">IST</time></p>
      </div>
    </div>

    <p class="foot-legal small muted">&copy; {year} Awadh Kishor Singh</p>
  </div>
</footer>

<style>
  .foot {
    margin-top: var(--section-gap);
    padding: clamp(3rem, 2rem + 4vw, 6rem) 0 2rem;
    background: var(--surface);
  }
  .foot-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    padding-bottom: clamp(2.5rem, 2rem + 3vw, 5rem);
  }
  .foot-email {
    font-size: var(--step-head);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.05;
    overflow-wrap: anywhere;
    transition: color 0.2s ease;
  }
  .foot-email:hover {
    color: var(--accent);
  }
  .foot-grid {
    row-gap: 2rem;
    padding-top: 2rem;
    box-shadow: 0 -1px 0 var(--line);
  }
  .foot-statement {
    grid-column: 1 / span 5;
    max-width: 44ch;
    color: var(--muted);
  }
  .foot-nav {
    grid-column: 7 / span 2;
  }
  .foot-social {
    grid-column: 9 / span 2;
  }
  .foot-time {
    grid-column: 11 / span 2;
  }
  .foot-time p {
    font-size: inherit;
    line-height: 1.5;
  }
  .foot-time p.muted {
    color: var(--muted);
  }
  .foot-link {
    color: var(--ink);
    transition: color 0.2s ease;
  }
  .foot-link:hover {
    color: var(--accent);
  }
  .foot-legal {
    margin-top: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }

  @media (max-width: 899px) {
    .foot-statement {
      grid-column: 1 / -1;
    }
    .foot-nav {
      grid-column: 1 / span 4;
    }
    .foot-social {
      grid-column: 5 / span 4;
    }
    .foot-time {
      grid-column: 9 / span 4;
    }
  }
  @media (max-width: 559px) {
    .foot-nav,
    .foot-social {
      grid-column: span 6;
    }
    .foot-time {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  // The local time in Bengaluru, refreshed every half minute.
  const el = document.getElementById('localTime');
  const fmt = new Intl.DateTimeFormat('en-IN', {
    timeZone: 'Asia/Kolkata',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  });
  const tick = () => {
    if (el) el.textContent = `${fmt.format(new Date())} IST`;
  };
  tick();
  setInterval(tick, 30_000);
</script>
