---
import { socials } from '../utils/socials';
import { resumeUrl } from '../utils/site';

const navItems = [
  { label: 'About', href: '/about' },
  { label: 'Experience', href: '/experience' },
  { label: 'Work', href: '/projects' },
  { label: 'Skills', href: '/skills' },
  { label: 'Credentials', href: '/certifications' },
  { label: 'Contact', href: '/contact' },
];

const year = new Date().getFullYear();
---

<footer class="mt-28 border-t border-[var(--fg)] bg-[var(--bg-2)]">
  <!-- ───────── CTA ───────── -->
  <div class="wrap py-16 md:py-24">
    <div class="grid gap-10 md:grid-cols-[1.35fr_1fr] md:items-end">
      <div>
        <span class="eyebrow">Let&rsquo;s build</span>
        <h2 class="mt-5 max-w-[14ch]">
          Got a project or a role <span class="italic text-[var(--accent)]">in mind?</span>
        </h2>
      </div>
      <div class="md:pb-2">
        <p class="max-w-sm text-[0.97rem] leading-relaxed">
          I&rsquo;m open to software engineering, full-stack and AI/ML roles, and to internship
          and freelance opportunities.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/contact" class="btn btn-primary">Say hello</a>
          <a href={resumeUrl} target="_blank" rel="noopener noreferrer" class="btn">Résumé</a>
        </div>
      </div>
    </div>
  </div>

  <!-- ───────── COLOPHON ───────── -->
  <div class="wrap">
    <div class="grid gap-10 border-t border-[var(--border)] py-14 md:grid-cols-[1.7fr_1fr_1fr]">
      <div>
        <p
          class="m-0 text-lg text-[var(--fg)]"
          style="font-family:var(--font-display);font-weight:600;letter-spacing:-0.024em;"
        >
          Awadh Kishor Singh
        </p>
        <p class="mt-4 max-w-sm text-sm leading-relaxed">
          Full Stack AI Developer building production-ready web applications from Bengaluru.
          Most recently Full Stack Developer Intern at IAVerse, a Data Science undergraduate at
          IIT Madras, and currently building my first mobile app.
        </p>
        <div
          class="mt-6 inline-flex items-center gap-2.5 rounded-full border border-[var(--border-bright)] bg-[var(--surface)] px-3.5 py-1.5"
        >
          <span class="pulse"></span>
          <span class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-[var(--fg-dim)]">
            Open to internships &amp; freelance
          </span>
        </div>
      </div>

      <div>
        <p class="kicker mb-4">Pages</p>
        <ul class="flex flex-col gap-2.5">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-[var(--fg-dim)] transition-colors duration-200 hover:text-[var(--accent)]"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="kicker mb-4">Elsewhere</p>
        <ul class="flex flex-col gap-2.5">
          {
            socials.map((social) => (
              <li>
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex items-center gap-1.5 text-sm text-[var(--fg-dim)] transition-colors duration-200 hover:text-[var(--accent)]"
                >
                  {social.label}
                  <span class="text-[var(--muted)] opacity-0 transition-opacity group-hover:opacity-100">
                    &#8599;
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="flex flex-col gap-2 border-t border-[var(--border)] py-7 font-mono text-[0.64rem] uppercase tracking-[0.14em] text-[var(--muted)] sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="m-0">&copy; {year} Awadh Kishor Singh</p>
      <p class="m-0">Bengaluru, India &middot; Set in Inter Tight &amp; Inter</p>
    </div>
  </div>
</footer>
