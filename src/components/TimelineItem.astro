---
interface Props {
  type: 'work' | 'education';
  title: string;
  company: string;
  meta: string;
  date: string;
  current?: boolean;
  points?: string[];
  tags?: string[];
}

const { type, title, company, meta, date, current = false, points = [], tags = [] } = Astro.props;
const isWork = type === 'work';
---

<article class="entry grid gap-x-10 gap-y-5 border-t border-[var(--border)] pt-8 md:grid-cols-[13rem_1fr]">
  <!-- Left rail: dates + kind -->
  <div class="md:sticky md:top-24 md:self-start">
    <p class="m-0 font-mono text-[0.68rem] uppercase tracking-[0.16em] text-[var(--fg)]">{date}</p>
    <p class="m-0 mt-2 flex items-center gap-2">
      <span
        class={`inline-block h-1.5 w-1.5 rounded-full ${
          isWork ? 'bg-[var(--accent)]' : 'bg-[var(--border-bright)]'
        }`}></span>
      <span class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-[var(--muted)]">
        {isWork ? 'Work' : 'Education'}
      </span>
    </p>
    {
      current && (
        <p class="m-0 mt-3 inline-flex items-center gap-2 rounded-full border border-[var(--border-bright)] bg-[var(--surface)] px-3 py-1">
          <span class="pulse" />
          <span class="font-mono text-[0.6rem] uppercase tracking-[0.16em] text-[var(--fg-dim)]">
            Current
          </span>
        </p>
      )
    }
  </div>

  <!-- Right: the entry itself -->
  <div class="min-w-0 pb-4">
    <h3 class="m-0 text-2xl md:text-[1.7rem]">{title}</h3>
    <p
      class="m-0 mt-1.5 text-[1.02rem] font-medium text-[var(--fg)]"
      style="font-family:var(--font-display);letter-spacing:-0.018em;"
    >
      {company}
      <span class="text-[var(--muted)]">&mdash; {meta}</span>
    </p>

    {
      points.length > 0 && (
        <ul class="mt-5 flex flex-col gap-3.5">
          {points.map((point) => (
            <li class="grid grid-cols-[0.9rem_1fr] gap-3 text-[0.95rem] leading-relaxed text-[var(--fg-dim)]">
              <span class="mt-[0.72em] h-px w-full bg-[var(--border-bright)]" />
              <span>{point}</span>
            </li>
          ))}
        </ul>
      )
    }

    {
      tags.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="chip">{tag}</span>
          ))}
        </div>
      )
    }
  </div>
</article>
