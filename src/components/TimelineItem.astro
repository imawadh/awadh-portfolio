---
interface Props {
  type: 'work' | 'education';
  title: string;
  company: string;
  meta: string;
  date: string;
  current?: boolean;
  points?: string[];
  tags?: string[];
}

const { title, company, meta, date, current = false, points = [], tags = [] } = Astro.props;
---

<article class="grid gap-x-12 gap-y-4 border-t border-[var(--border-bright)] py-9 md:grid-cols-[13rem_1fr] md:py-11">
  <!-- Left rail: when -->
  <div class="md:sticky md:top-24 md:self-start ui">
    <p class="m-0 text-[1rem] font-semibold text-[var(--fg)] ui">{date}</p>
    {
      current && (
        <p class="m-0 mt-3 inline-flex items-center gap-2 text-[0.95rem] text-[var(--signal)] ui">
          <span class="pulse" />
          Current
        </p>
      )
    }
  </div>

  <!-- The entry itself -->
  <div class="min-w-0">
    <h3 class="m-0 text-[1.9rem] md:text-[2.2rem]">{title}</h3>
    <p class="m-0 mt-2 text-[1.08rem] text-[var(--fg)] ui">
      {company}<span class="text-[var(--muted)]">, {meta}</span>
    </p>

    {
      points.length > 0 && (
        <ul class="prose-serif mt-5 flex max-w-[66ch] list-disc flex-col gap-2.5 pl-5 marker:text-[var(--accent)]">
          {points.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      )
    }

    {
      tags.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <span class="chip">{tag}</span>
          ))}
        </div>
      )
    }
  </div>
</article>
