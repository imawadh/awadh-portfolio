---
interface Props {
  index: string;
  date: string;
  title: string;
  issuer: string;
  details: string;
  url: string;
}

const { index, date, title, issuer, details, url } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="cert-row group grid items-baseline gap-x-6 gap-y-2 border-t border-[var(--border)] py-7 transition-colors duration-200 last:border-b hover:bg-[var(--surface-2)]"
>
  <span class="font-mono text-[0.66rem] tracking-[0.19em] text-[var(--muted)]">{index}</span>

  <div class="min-w-0">
    <h3 class="m-0 text-xl transition-colors duration-200 group-hover:text-[var(--accent)]">
      {title}
    </h3>
    <p class="m-0 mt-1 text-[0.95rem] font-medium text-[var(--fg-dim)]">{issuer}</p>
    <p class="m-0 mt-2 text-sm text-[var(--muted)]">{details}</p>
  </div>

  <div class="flex items-baseline justify-between gap-4 md:flex-col md:items-end md:gap-2">
    <span class="font-mono text-[0.64rem] uppercase tracking-[0.16em] text-[var(--muted)]">
      {date}
    </span>
    <span
      class="inline-flex items-center gap-1.5 font-mono text-[0.64rem] uppercase tracking-[0.14em] text-[var(--fg)] transition-colors duration-200 group-hover:text-[var(--accent)]"
    >
      Verify &#8599;
    </span>
  </div>
</a>

<style>
  .cert-row {
    grid-template-columns: auto 1fr;
  }
  .cert-row > :last-child {
    grid-column: 1 / -1;
  }
  @media (min-width: 768px) {
    .cert-row {
      grid-template-columns: 2.5rem 1fr 9rem;
    }
    .cert-row > :last-child {
      grid-column: auto;
    }
  }
</style>
