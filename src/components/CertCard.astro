---
interface Props {
  index?: string;
  date: string;
  title: string;
  issuer: string;
  details: string;
  url: string;
}

const { date, title, issuer, details, url } = Astro.props;
---

<!-- A two-ended row linking to the certificate's verification page: title and
     issuer on the left, what it covered in the middle, the date on the right. -->
<a href={url} target="_blank" rel="noopener noreferrer" class="cert grid-12 group">
  <div class="c-title">
    <h3 class="transition-colors duration-200 group-hover:text-[var(--accent)]">{title}</h3>
    <p class="small muted mt-1">{issuer}</p>
  </div>
  <p class="c-details">
    {details}
    <span class="c-verify">Verify &#8599;<span class="sr-only"> (opens in a new tab)</span></span>
  </p>
  <p class="c-date small muted figures">{date}</p>
</a>

<style>
  .cert {
    align-items: baseline;
    row-gap: 0.5rem;
    padding: 1.6rem 0;
  }
  .c-title {
    grid-column: 1 / span 6;
  }
  .c-details {
    grid-column: 7 / span 4;
    max-width: 44ch;
  }
  .c-verify {
    display: block;
    margin-top: 0.35rem;
    font-size: var(--step-small);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    text-decoration-color: var(--muted);
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }
  .cert:hover .c-verify {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  .c-date {
    grid-column: 11 / span 2;
    text-align: right;
  }

  @media (max-width: 899px) {
    .c-title {
      grid-column: 1 / span 9;
    }
    .c-date {
      grid-column: 10 / span 3;
      grid-row: 1;
    }
    .c-details {
      grid-column: 1 / -1;
    }
  }
</style>
