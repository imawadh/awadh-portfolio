---
import { socials } from '../utils/socials';

interface NavItem {
  label: string;
  href: string;
}

const navItems: NavItem[] = [
  { label: 'Work', href: '/projects' },
  { label: 'About', href: '/about' },
  { label: 'Experience', href: '/experience' },
  { label: 'Skills', href: '/skills' },
  { label: 'Credentials', href: '/certifications' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<nav id="siteNav" class="sticky top-0 z-50 bg-[rgba(232,235,227,0.86)] backdrop-blur-md">
  <div class="wrap flex items-center justify-between gap-6 py-3.5">
    <a href="/" class="wordmark shrink-0" aria-label="Awadh Kishor Singh, home">
      Awadh Kishor Singh
    </a>

    <!-- Desktop nav -->
    <div class="hidden items-center gap-1 lg:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class={`nav-link ${isActive(item.href) ? 'is-active' : ''}`}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/contact"
        aria-current={isActive('/contact') ? 'page' : undefined}
        class="btn btn-primary ml-4 !min-h-0 !px-5 !py-2 !text-[0.95rem]"
      >
        Contact
      </a>
    </div>

    <!-- Mobile toggle -->
    <button
      id="navToggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="navMenu"
      class="nav-toggle inline-flex h-11 items-center gap-2.5 rounded-full border-[1.5px] border-[var(--fg)] px-4 text-[0.95rem] font-semibold text-[var(--fg)] lg:hidden"
    >
      <span class="toggle-label-closed">Menu</span>
      <span class="toggle-label-open">Close</span>
      <span class="relative flex h-3 w-4 flex-col items-center justify-center">
        <span class="bar bar-top absolute h-[1.5px] w-4 bg-current transition-transform duration-300"></span>
        <span class="bar bar-bot absolute h-[1.5px] w-4 bg-current transition-transform duration-300"></span>
      </span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    id="navMenu"
    class="nav-menu invisible absolute left-0 right-0 top-full max-h-[calc(100dvh-4.5rem)] -translate-y-2 overflow-y-auto bg-[var(--bg)] opacity-0 transition-all duration-300 ease-out lg:hidden"
  >
    <div class="wrap pb-10 pt-4">
      <ul class="flex flex-col">
        {
          [...navItems, { label: 'Contact', href: '/contact' }].map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class={`menu-link block py-2 ${isActive(item.href) ? 'text-[var(--accent)]' : 'text-[var(--fg)]'}`}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-8 flex flex-wrap gap-2">
        {
          socials.map((social) => (
            <a href={social.url} target="_blank" rel="noopener noreferrer" class="chip">
              {social.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</nav>

<style>
  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    font-variation-settings: 'wdth' 80;
    letter-spacing: -0.02em;
    color: var(--fg);
    transition: color 0.2s ease;
  }
  .wordmark:hover {
    color: var(--accent);
  }

  .nav-link {
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 520;
    color: var(--fg-dim);
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }
  .nav-link:hover {
    color: var(--fg);
    background: var(--bg-2);
  }
  .nav-link.is-active {
    color: var(--fg);
    background: var(--bg-2);
  }

  .menu-link {
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 700;
    font-variation-settings: 'wdth' 78;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .nav-toggle .bar-top {
    transform: translateY(-3px);
  }
  .nav-toggle .bar-bot {
    transform: translateY(3px);
  }
  .nav-toggle[aria-expanded='true'] .bar-top {
    transform: translateY(0) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .bar-bot {
    transform: translateY(0) rotate(-45deg);
  }
  .nav-toggle[aria-expanded='true'] .toggle-label-closed {
    display: none;
  }
  .nav-toggle[aria-expanded='false'] .toggle-label-open {
    display: none;
  }

  .nav-menu.is-open {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const nav = document.getElementById('siteNav');
  const navToggle = document.getElementById('navToggle');
  const navMenu = document.getElementById('navMenu');

  const setOpen = (open: boolean) => {
    if (!navToggle || !navMenu) return;
    navToggle.setAttribute('aria-expanded', String(open));
    navToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    navMenu.classList.toggle('is-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
  };

  navToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    setOpen(navToggle.getAttribute('aria-expanded') !== 'true');
  });

  navMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  document.addEventListener('click', (e) => {
    if (!nav?.contains(e.target as Node)) setOpen(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
