---
/**
 * A project as one wide row: name and tagline on the left, what it is and
 * the links on the right. Rows stack into a list with a rule between them.
 */
interface Props {
  index?: string;
  name: string;
  tagline: string;
  role?: string;
  description: string;
  tags: string[];
  status: string;
  live?: string;
  code?: string;
  caseStudy?: string;
}

const { name, tagline, role, description, tags, live, code, caseStudy } = Astro.props;
const href = caseStudy ?? live ?? code ?? '#';
---

<article class="project-row group grid gap-x-12 gap-y-5 border-t border-[var(--border-bright)] py-9 md:grid-cols-[5fr_7fr] md:py-12">
  <div>
    <h3 class="project-name m-0">
      <a href={href} class="project-hit">{name}</a>
    </h3>
    <p class="m-0 mt-3 max-w-[30ch] text-[1.1rem] leading-snug text-[var(--fg)] ui">
      {tagline}
    </p>
    {role && <p class="m-0 mt-2 text-[0.95rem] text-[var(--muted)] ui">{role}</p>}
  </div>

  <div class="relative z-[1] flex flex-col gap-5">
    <p class="m-0 max-w-[60ch]">{description}</p>

    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => <span class="chip">{tag}</span>)}
    </div>

    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 pt-1">
      {caseStudy && <a href={caseStudy} class="row-link row-link-main">Read the case study</a>}
      {live && <a href={live} target="_blank" rel="noopener noreferrer" class="row-link">Visit the site</a>}
      {code && <a href={code} target="_blank" rel="noopener noreferrer" class="row-link">Source on GitHub</a>}
    </div>
  </div>
</article>

<style>
  .project-row {
    position: relative;
  }
  .project-name {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 700;
    font-variation-settings: 'wdth' 78;
    letter-spacing: -0.035em;
    line-height: 0.95;
    transition: color 0.2s ease;
  }
  /* The whole row is clickable through the name's link; the right column's
     own links sit above it. */
  .project-hit::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .project-row:hover .project-name {
    color: var(--accent);
  }
  .row-link {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 560;
    color: var(--fg-dim);
    text-decoration: underline;
    text-decoration-color: var(--border-bright);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition:
      color 0.2s ease,
      text-decoration-color 0.2s ease;
  }
  .row-link-main {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  .row-link:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  @media (pointer: coarse) {
    .row-link {
      display: inline-flex;
      min-height: 44px;
      align-items: center;
    }
  }
</style>
