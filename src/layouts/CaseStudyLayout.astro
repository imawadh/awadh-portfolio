---
import PageLayout from './PageLayout.astro';

interface Props {
  name: string;
  tagline: string;
  description: string;
  role: string;
  status: string;
  stackSummary: string;
  live?: string;
  code?: string;
  links?: { label: string; url: string }[];
}

const { name, tagline, description, role, status, stackSummary, live, code, links } = Astro.props;

const meta = [
  { key: 'Role', value: role },
  { key: 'Status', value: status },
  { key: 'Stack', value: stackSummary },
];
---

<PageLayout title={`${name} — Awadh Kishor Singh`} description={description}>
  <article class="wrap band-lead">
    <a href="/projects" class="back-link ui">All projects</a>

    <h1 class="case-title reveal reveal-1 mt-6">{name}</h1>
    <p class="case-tagline reveal reveal-2 mt-5 max-w-[30ch]">{tagline}</p>

    <dl class="reveal reveal-3 mt-12 grid gap-y-6 rounded-[var(--radius)] bg-[var(--surface)] p-6 sm:grid-cols-3 sm:gap-x-8 md:p-8">
      {
        meta.map((m) => (
          <div>
            <dt class="ui text-[0.95rem] text-[var(--muted)]">{m.key}</dt>
            <dd class="ui m-0 mt-1 text-[1.08rem] font-medium leading-snug text-[var(--fg)]">{m.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="case-body mt-16 flex flex-col gap-16 md:mt-20 md:gap-20">
      <slot />
    </div>

    <div class="mt-16 flex flex-wrap gap-3 border-t border-[var(--border-bright)] pt-10">
      {
        links && links.length > 0
          ? links.map((l) => (
              <a href={l.url} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                {l.label}
              </a>
            ))
          : live && (
              <a href={live} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                Visit the live site
              </a>
            )
      }
      {
        code && (
          <a href={code} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
            Source on GitHub
          </a>
        )
      }
      <a href="/projects" class="btn btn-ghost">All projects</a>
    </div>

    <div class="mt-12 flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
      <p class="m-0 max-w-[48ch]">
        Need something built like {name}? Tell me what you&rsquo;re working on.
      </p>
      <a href="/contact" class="btn btn-primary shrink-0">Start a conversation</a>
    </div>
  </article>
</PageLayout>

<style>
  .back-link {
    font-size: 1rem;
    font-weight: 560;
    color: var(--muted);
    text-decoration: underline;
    text-decoration-color: var(--border-bright);
    text-underline-offset: 0.22em;
  }
  .back-link:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  .case-title {
    font-size: clamp(3.4rem, 12vw, 9rem);
    font-variation-settings: 'wdth' 75;
    letter-spacing: -0.03em;
    line-height: 0.86;
  }
  .case-tagline {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2.8vw, 2rem);
    line-height: 1.3;
    color: var(--fg);
  }
</style>

<style is:global>
  /* Case study sections: margin heading on wide screens, stacked on narrow. */
  @media (min-width: 900px) {
    .case-body > section {
      display: grid;
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      column-gap: 4rem;
    }
    .case-body > section > h2 {
      grid-column: 1;
      grid-row: 1 / span 20;
      align-self: start;
      position: sticky;
      top: 6.5rem;
    }
    .case-body > section > :not(h2) {
      grid-column: 2;
    }
  }
  .case-body section > h2 {
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    margin-bottom: 1.25rem;
  }
  .case-body section > :not(h2) + * {
    margin-top: 1.1rem;
  }
  .case-body section > p {
    max-width: 64ch;
  }
</style>
