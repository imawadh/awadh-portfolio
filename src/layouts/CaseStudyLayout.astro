---
import PageLayout from './PageLayout.astro';

interface Props {
  name: string;
  tagline: string;
  description: string;
  role: string;
  status: string;
  stackSummary: string;
  live?: string;
  code?: string;
  links?: { label: string; url: string }[];
}

const { name, tagline, description, role, status, stackSummary, live, code, links } = Astro.props;

const meta = [
  { key: 'Role', value: role },
  { key: 'Status', value: status },
  { key: 'Stack', value: stackSummary },
];
---

<PageLayout title={`${name} — Awadh Kishor Singh`} description={description}>
  <article class="wrap band band-a band-lead">
    <a
      href="/projects"
      class="reveal reveal-1 inline-flex items-center gap-2 font-mono text-[0.66rem] uppercase tracking-[0.16em] text-[var(--muted)] transition-colors hover:text-[var(--accent)]"
    >
      &larr; All work
    </a>

    <span class="eyebrow reveal reveal-1 mt-8 block">Case study</span>
    <h1 class="reveal reveal-2 mt-5 max-w-[14ch]">{name}</h1>
    <p
      class="reveal reveal-2 mt-6 max-w-[42ch] text-2xl leading-[1.28] text-[var(--fg-dim)] md:text-3xl"
      style="font-family:var(--font-display);font-weight:400;letter-spacing:-0.024em;"
    >
      {tagline}
    </p>

    <!-- Meta strip -->
    <dl
      class="reveal reveal-3 mt-12 grid gap-y-7 border-y border-[var(--fg)] py-7 sm:grid-cols-3 sm:gap-x-8"
    >
      {
        meta.map((m) => (
          <div>
            <dt class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-[var(--accent)]">
              {m.key}
            </dt>
            <dd class="m-0 mt-2 text-[0.95rem] leading-snug text-[var(--fg)]">{m.value}</dd>
          </div>
        ))
      }
    </dl>

    <!-- Body -->
    <div class="reveal reveal-4 case-body mt-16 flex flex-col gap-14">
      <slot />
    </div>

    <!-- Footer links -->
    <div class="mt-16 flex flex-wrap gap-3 border-t border-[var(--fg)] pt-10">
      {
        links && links.length > 0
          ? links.map((l) => (
              <a href={l.url} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                {l.label}
              </a>
            ))
          : live && (
              <a href={live} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                Visit live site &#8599;
              </a>
            )
      }
      {
        code && (
          <a href={code} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
            View code &#8599;
          </a>
        )
      }
      <a href="/projects" class="btn btn-ghost">All work</a>
      <a href="/contact" class="btn btn-ghost">Get in touch</a>
    </div>
  </article>
</PageLayout>

<style is:global>
  .case-body section > h2 {
    position: relative;
    padding-top: 1.4rem;
    margin-bottom: 1.4rem;
    border-top: 1px solid var(--border);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }
  .case-body section > h2::after {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 3.5rem;
    height: 1px;
    background: var(--accent);
  }
  /* consistent gap between any heading and the content that follows it */
  .case-body section > h2 + * {
    margin-top: 0;
  }
  .case-body section > p {
    max-width: 68ch;
    line-height: 1.78;
    font-size: 1.02rem;
  }
  .case-body section > p + p {
    margin-top: 1.1rem;
  }
</style>
