---
import PageLayout from '../layouts/PageLayout.astro';
import TimelineItem from '../components/TimelineItem.astro';
import { resumeUrl } from '../utils/site';
import { projects } from '../data/projects';
import { shots, SIZE } from '../data/shots';

const experiences = [
  {
    type: 'work' as const,
    title: 'Full Stack Developer Intern',
    company: 'IAVerse',
    meta: 'Remote',
    date: 'Feb 2026 — Aug 2026',
    current: false,
    points: [
      'Migrated a 1,200+ page WordPress site to a custom-built Next.js application — rebuilding content architecture, routing, and UI components from scratch with zero data loss.',
      'Engineered a scalable page and component system to support 1,200+ content pages, delivering measurable gains in performance, SEO, and long-term maintainability over the WordPress baseline.',
      'Instrumented the platform with Mixpanel and Sentry, using step-level error tracking to resolve 5–6 recurring production issues and drive data-informed product decisions.',
      'Developed a doctor–patient booking and management module with supporting REST APIs, handling appointment scheduling, patient records, and provider workflows.',
      'Led SEO, GEO (Generative Engine Optimization), and AEO (Answer Engine Optimization) work, increasing organic traffic by 5–6%.',
    ],
    tags: ['Next.js', 'React', 'Tailwind CSS', 'NestJS', 'Mixpanel', 'Sentry'],
  },
  {
    type: 'work' as const,
    title: 'Full Stack AI Engineer',
    company: 'KaiKa AI',
    meta: 'Remote',
    date: 'Nov 2025 — Feb 2026',
    current: false,
    points: [
      "Engineered the full-stack web application for KaiKa AI's workforce alignment platform, from the React front end through to the Node.js and Express API layer.",
      "Trained a machine learning model in Python and scikit-learn to generate employee alignment scores, powering the platform's core scoring engine.",
      'Deployed the application across AWS Amplify (frontend) and AWS EC2 (backend), handling environment configuration for production.',
    ],
    tags: ['Next.js', 'React', 'Node.js', 'Express.js', 'Python', 'scikit-learn', 'AWS'],
  },
  {
    type: 'work' as const,
    title: 'Full Stack Developer (Freelance)',
    company: 'SRS Classes',
    meta: 'Remote',
    date: 'Nov 2024 — Dec 2024',
    current: false,
    points: [
      'Built and shipped a responsive educational web application with Next.js and React, supporting 1,500+ daily active users with stable cross-device performance.',
      'Reduced page load times by ~30% through server-side rendering optimisations, asset compression, and SEO best practices.',
      'Owned the full product lifecycle solo — feature development, cloud deployment, monitoring, and post-launch maintenance — as a solo contractor over one month.',
    ],
    tags: ['Next.js', 'React', 'Tailwind CSS', 'Framer Motion', 'MongoDB', 'Vercel'],
  },
  {
    type: 'education' as const,
    title: 'BS in Data Science & Applications',
    company: 'IIT Madras',
    meta: 'Chennai, India',
    date: 'Apr 2024 — Jun 2028',
    current: true,
    points: [
      'Undergraduate degree focused on data science, statistics, programming, and applied machine learning.',
      'Current CGPA: 8.27.',
    ],
    tags: ['Python', 'Statistics', 'Machine Learning', 'DSA'],
  },
  {
    type: 'education' as const,
    title: 'Intermediate (Higher Secondary)',
    company: "Central Hindu Boys' School (B.H.U)",
    meta: 'Varanasi, India',
    date: 'Apr 2021 — Jun 2023',
    current: false,
    points: ['Higher secondary education with a focus on mathematics and science.'],
    tags: [],
  },
];

const work = experiences.filter((e) => e.type === 'work');
const education = experiences.filter((e) => e.type === 'education');

// None of the three roles has screens of its own (IAVerse, KaiKa AI and SRS Classes),
// so the pictures on this page are the products built alongside them.
const alongside = ['prsnn', 'prescripto', 'axiora-learning', 'evaa'].map((slug) => {
  const p = projects.find((x) => x.slug === slug)!;
  return { slug, name: p.name, href: p.caseStudy, shot: shots[slug][0] };
});
---

<PageLayout
  title="Experience & Education — Awadh Kishor Singh"
  description="Work experience and education of Awadh Kishor Singh — Full Stack Developer Intern at IAVerse, Full Stack AI Engineer at KaiKa AI, freelance work for SRS Classes, and a BS in Data Science at IIT Madras."
>
  <!-- ───────────── LEAD ───────────── -->
  <section class="wrap band-lead lead-row grid-12">
    <div class="lead-main">
      <h1 class="page-title reveal reveal-1">A record of shipped work</h1>
      <p class="page-lede reveal reveal-2 mt-8 max-w-[34ch]">
        Professional work and academic background — most recent first.
      </p>
    </div>
    <div class="lead-side reveal reveal-3">
      <p class="small inline-flex items-start gap-2.5">
        <span class="pulse mt-[0.45em]"></span>
        Open to internships and freelance opportunities — software engineering, full-stack and AI/ML.
      </p>
      <a href="/contact" class="link small mt-3 inline-block">Get in touch &rarr;</a>
    </div>
  </section>

  <!-- ───────────── WORK: one wide entry per role ───────────── -->
  <section class="wrap section" aria-labelledby="work-title">
    <div class="grid-12 sec-head">
      <h2 id="work-title" class="sec-h" data-rise>Work</h2>
    </div>
    <div class="mt-16">
      {
        work.map((exp) => (
          <TimelineItem
            type={exp.type}
            title={exp.title}
            company={exp.company}
            meta={exp.meta}
            date={exp.date}
            current={exp.current}
            points={exp.points}
            tags={exp.tags}
          />
        ))
      }
    </div>
  </section>

  <!-- ───────────── EDUCATION: the two schools side by side, on a tone step ───────────── -->
  <section class="section edu" aria-labelledby="edu-title">
    <div class="wrap grid-12 edu-grid">
      <div class="edu-head">
        <h2 id="edu-title" class="sec-h" data-rise>Education</h2>
      </div>
      {
        education.map((exp, i) => (
          <article class={`edu-item edu-${i}`} data-rise style={`--i: ${i + 1}`}>
            <p class="small figures">{exp.date}</p>
            {exp.current && (
              <p class="small mt-1 inline-flex items-center gap-2">
                <span class="pulse" />
                Current
              </p>
            )}
            <h3 class="mt-5">{exp.title}</h3>
            <p class="mt-2">{exp.company} <span class="muted">&mdash; {exp.meta}</span></p>
            <ul class="edu-points">
              {exp.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
            {exp.tags.length > 0 && <p class="small muted mt-5">{exp.tags.join(', ')}</p>}
          </article>
        ))
      }
    </div>
  </section>

  <!-- ───────────── ALONGSIDE: the products shipped between the roles ───────────── -->
  <section class="wrap section alongside grid-12" aria-labelledby="along-title">
    <div class="along-text">
      <h2 id="along-title" class="lead-h" data-rise>Selected work</h2>
    </div>
    <ul class="along-shots">
      {
        alongside.map((a, i) => (
          <li data-rise style={`--i: ${i + 1}`}>
            <a href={a.href} class="shot group" aria-label={`${a.name} case study`}>
              <img
                src={a.shot.src}
                alt={a.shot.alt}
                width={SIZE.desktop.width}
                height={SIZE.desktop.height}
                loading="lazy"
                decoding="async"
              />
              <span class="small mt-2 block group-hover:text-[var(--accent)]">{a.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ───────────── RÉSUMÉ ───────────── -->
  <section class="wrap section resume last grid-12" aria-labelledby="resume-title">
    <div class="resume-text">
      <h2 id="resume-title" class="sec-h" data-rise>Résumé</h2>
      <p class="lead mt-6 max-w-[30ch]" data-rise style="--i: 1">
        Want the full picture in one page? Grab the PDF.
      </p>
    </div>
    <div class="resume-actions" data-rise style="--i: 2">
      <a href={resumeUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
        Download résumé
      </a>
      <a href="/projects" class="btn btn-ghost">View work</a>
    </div>
  </section>
</PageLayout>

<style>
  .lead-row {
    align-items: end;
    row-gap: 2rem;
  }
  .lead-main {
    grid-column: 1 / span 8;
  }
  .lead-side {
    grid-column: 10 / span 3;
    padding-bottom: 0.4rem;
  }
  .section {
    margin-top: var(--section-gap);
  }
  .sec-head {
    align-items: end;
    row-gap: 1rem;
  }
  .sec-h {
    grid-column: 1 / span 3;
    font-size: var(--step-head);
  }
  .sec-note {
    grid-column: 4 / span 6;
    max-width: 46ch;
  }

  .edu {
    background: var(--surface);
    padding-top: calc(var(--section-gap) / 2);
    padding-bottom: calc(var(--section-gap) / 2);
  }
  .edu-grid {
    align-items: start;
    row-gap: 3rem;
  }
  .edu-head {
    grid-column: 1 / span 3;
  }
  .edu-0 {
    grid-column: 4 / span 5;
  }
  .edu-1 {
    grid-column: 9 / span 4;
  }
  .edu-points {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .edu-points li {
    font-size: var(--step-body);
    line-height: 1.45;
    max-width: 44ch;
  }

  .alongside {
    align-items: end;
    row-gap: 2rem;
  }
  .along-text {
    grid-column: 1 / span 3;
  }
  .lead-h {
    font-size: var(--step-lead);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .along-shots {
    grid-column: 4 / span 9;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  .shot img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    background: var(--surface);
  }
  .shot {
    display: block;
  }
  .last {
    padding-bottom: calc(var(--section-gap) / 2);
  }

  .resume {
    align-items: end;
    row-gap: 2rem;
  }
  .resume-text {
    grid-column: 1 / span 7;
  }
  .resume-actions {
    grid-column: 9 / span 4;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: flex-end;
  }

  @media (max-width: 899px) {
    .lead-main,
    .lead-side,
    .sec-h,
    .sec-note,
    .edu-head,
    .edu-0,
    .edu-1,
    .resume-text,
    .resume-actions,
    .along-text,
    .along-shots {
      grid-column: 1 / -1;
    }
    .along-shots {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }
  @media (min-width: 600px) and (max-width: 899px) {
    .sec-h,
    .edu-head {
      grid-column: 1 / span 4;
    }
    .sec-note {
      grid-column: 5 / span 8;
    }
    .edu-0,
    .edu-1 {
      grid-column: 5 / span 8;
    }
    .alongside {
      align-items: start;
    }
    .along-text {
      grid-column: 1 / span 4;
    }
    .along-shots {
      grid-column: 5 / span 8;
    }
    .resume-text {
      grid-column: 1 / span 7;
    }
    .resume-actions {
      grid-column: 8 / span 5;
      flex-direction: column;
      align-items: stretch;
    }
    .resume-actions {
      justify-content: flex-start;
    }
  }
</style>
