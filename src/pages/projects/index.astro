---
import PageLayout from '../../layouts/PageLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { personalProjects, freelanceProjects, projects } from '../../data/projects';
---

<PageLayout
  title="Projects — Awadh Kishor Singh"
  description="Projects by Awadh Kishor Singh — personal builds (Prescripto, Cryptofolio) and freelance client work (Axiora Learning, EVAA Enterprises, The SRS Classes, Prsnn)."
>
  <section class="wrap band band-a band-lead">
    <span class="eyebrow reveal reveal-1">Work</span>
    <h1 class="reveal reveal-2 mt-6 max-w-[13ch]">Products, shipped end to end</h1>
    <p
      class="reveal reveal-2 mt-7 max-w-[50ch] text-2xl leading-[1.3] text-[var(--fg-dim)] md:text-[1.9rem]"
      style="font-family:var(--font-display);font-weight:400;letter-spacing:-0.028em;"
    >
      Full-stack applications and client websites built end-to-end — most live in production with
      real users. Each ships its own architecture, build, and deployment story.
    </p>

    <!-- Tally strip -->
    <dl
      class="reveal reveal-3 mt-12 grid grid-cols-2 gap-y-6 border-y border-[var(--fg)] py-6 sm:grid-cols-4"
    >
      <div>
        <dd class="numeral m-0 text-3xl text-[var(--fg)]">{projects.length}</dd>
        <dt class="mt-2 font-mono text-[0.62rem] uppercase tracking-[0.16em] text-[var(--muted)]">
          Projects
        </dt>
      </div>
      <div>
        <dd class="numeral m-0 text-3xl text-[var(--fg)]">{personalProjects.length}</dd>
        <dt class="mt-2 font-mono text-[0.62rem] uppercase tracking-[0.16em] text-[var(--muted)]">
          Personal
        </dt>
      </div>
      <div>
        <dd class="numeral m-0 text-3xl text-[var(--fg)]">{freelanceProjects.length}</dd>
        <dt class="mt-2 font-mono text-[0.62rem] uppercase tracking-[0.16em] text-[var(--muted)]">
          Freelance
        </dt>
      </div>
      <div>
        <dd class="numeral m-0 text-3xl text-[var(--accent)]">
          {projects.filter((p) => p.status === 'live').length}
        </dd>
        <dt class="mt-2 font-mono text-[0.62rem] uppercase tracking-[0.16em] text-[var(--muted)]">
          Live
        </dt>
      </div>
    </dl>

  </section>

  <section class="wrap band band-b">
    <!-- ───────── PERSONAL ───────── -->
    <div class="reveal reveal-4">
      <div class="section-head">
        <div>
          <span class="section-no">01</span>
          <h2 class="mt-3">Built to learn &amp; ship</h2>
        </div>
        <span class="hidden shrink-0 pb-1 font-mono text-[0.64rem] uppercase tracking-[0.16em] text-[var(--muted)] sm:inline">
          Personal projects
        </span>
      </div>
      <p class="mt-6 max-w-[58ch] text-[0.98rem] text-[var(--muted)]">
        Self-directed full-stack builds where I owned every architectural decision end-to-end.
      </p>
      <div class="mt-9 grid gap-6 md:grid-cols-2">
        {
          personalProjects.map((p) => (
            <ProjectCard
              index={p.index}
              name={p.name}
              tagline={p.tagline}
              description={p.description}
              tags={p.tags}
              status={p.status}
              live={p.live}
              code={p.code}
              caseStudy={p.caseStudy}
            />
          ))
        }
      </div>
    </div>

  </section>

  <section class="wrap band band-c">
    <!-- ───────── FREELANCE ───────── -->
    <div>
      <div class="section-head">
        <div>
          <span class="section-no">02</span>
          <h2 class="mt-3">Shipped for clients</h2>
        </div>
        <span class="hidden shrink-0 pb-1 font-mono text-[0.64rem] uppercase tracking-[0.16em] text-[var(--muted)] sm:inline">
          Freelance &amp; client work
        </span>
      </div>
      <p class="mt-6 max-w-[58ch] text-[0.98rem] text-[var(--muted)]">
        Independent contract work — production websites and platforms delivered for real businesses
        and live users.
      </p>
      <div class="mt-9 grid gap-6 md:grid-cols-2">
        {
          freelanceProjects.map((p) => (
            <ProjectCard
              index={p.index}
              name={p.name}
              tagline={p.tagline}
              description={p.description}
              tags={p.tags}
              status={p.status}
              live={p.live}
              code={p.code}
              caseStudy={p.caseStudy}
            />
          ))
        }
      </div>
    </div>

  </section>

  <section class="wrap band band-a">
    <!-- CTA -->
    <div
      class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between"
    >
      <div>
        <span class="eyebrow">Open for work</span>
        <h2 class="mt-4 text-3xl md:text-4xl">Have something to build?</h2>
        <p class="m-0 mt-3 max-w-md text-[0.98rem] text-[var(--fg-dim)]">
          I&rsquo;m open to internships and freelance engagements across full-stack and AI/ML work.
        </p>
      </div>
      <a href="/contact" class="btn btn-primary shrink-0">Start a conversation</a>
    </div>
  </section>
</PageLayout>
