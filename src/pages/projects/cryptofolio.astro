---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import Panel from '../../components/Panel.astro';
import { shots, SIZE } from '../../data/shots';

const wide = shots['cryptofolio'][0];
const tall = shots['cryptofolio'].filter((s) => s.kind === 'phone')[0];

const frontendStack = [
  'Next.js 14',
  'React 18',
  'Tailwind CSS 3.4',
  'PostCSS',
  'Autoprefixer',
  'Axios',
  'next-themes',
  'react-icons',
  'Sharp',
  'ESLint',
  'Vercel',
];

const backendStack = [
  'Node.js 22',
  'Express 4',
  'Mongoose 6',
  'MongoDB',
  'bcrypt',
  'jsonwebtoken',
  'Helmet',
  'express-rate-limit',
  'express-validator',
  'CORS',
  'dotenv',
  'Nodemon',
  'mongodb-memory-server',
  'Render',
];

const security = [
  { k: 'JWT', v: 'Stateless token-based authentication' },
  { k: 'bcrypt', v: 'Salted password hashing at rest' },
  { k: 'Helmet', v: 'Hardened HTTP security headers' },
  { k: 'rate-limit', v: 'express-rate-limit guards API abuse' },
  { k: 'validation', v: 'express-validator sanitises every input' },
  { k: 'CORS', v: 'Scoped cross-origin access control' },
];

const features = [
  'Live cryptocurrency prices via the CoinGecko API',
  'Interactive TradingView charts embedded client-side',
  'Virtual demo trading — every user starts at $10,000',
  'Holdings replayed from buy/sell transaction history',
  'JWT auth with bcrypt-hashed credentials',
  'Light and dark theme support via next-themes',
];
---

<CaseStudyLayout
  name="Cryptofolio"
  slug="cryptofolio"
  tagline="A decoupled MERN-stack crypto portfolio platform — Next.js 14 frontend, Express REST API, and a virtual demo-trading engine that computes holdings by replaying transaction history."
  description="Case study of Cryptofolio, a cryptocurrency portfolio management platform built with Next.js 14, Express, MongoDB, and the CoinGecko API."
  role="Full Stack Developer"
  status="Live · Vercel + Render"
  stackSummary="Next.js 14 · Express · MongoDB"
  live="https://crytofolio.vercel.app/"
  code="https://github.com/imawadh/crytofolio"
>
  <section class="cs-open">
    <h2 data-rise>Overview</h2>
    <div class="cs-main">
      <p data-rise style="--i: 1">
        Cryptofolio is a cryptocurrency portfolio platform where users track digital assets and
        practice trading without risking real money. It pairs live market data with a virtual
        trading engine — every account starts with a $10,000 balance, and holdings are derived
        entirely from the user's recorded buy and sell history.
      </p>
    </div>
    <div class="cs-plates">
      <figure class="cs-plate-wide" data-rise style="--i: 2">
        <img src={wide.src} alt={wide.alt} width={SIZE.desktop.width} height={SIZE.desktop.height} loading="lazy" decoding="async" />
      </figure>
      <figure class="cs-plate-tall" data-rise style="--i: 3">
        <img src={tall.src} alt={tall.alt} width={SIZE.phone.width} height={SIZE.phone.height} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="cs-split">
    <h2 data-rise>The challenge</h2>
    <div class="cs-main">
      <p data-rise style="--i: 1">
        Crypto investors juggling holdings across exchanges had no single, calm view of their
        position — and no safe way to test a strategy before committing capital. The product needed
        live prices, a clean portfolio view, and a trading sandbox, all without a heavy backend or
        the risk of stale, drifting balances.
      </p>
    </div>
  </section>

  <section class="cs-stage">
    <div class="cs-top">
      <h2 data-rise>Architecture</h2>
      <p class="cs-intro" data-rise style="--i: 1">
        Cryptofolio is a monorepo with separate <code>client/</code> and <code>server/</code>
        directories. The client is a Next.js 14 App Router frontend on Vercel; the server is an
        Express REST API on Render following an MVC structure — models → routes → controllers — with
        MongoDB accessed through Mongoose. The two talk over HTTP/JSON via Axios, while CoinGecko
        prices and TradingView charts are pulled straight into the browser to keep the backend lean.
      </p>
    </div>
    <div class="cs-figure">
      <Panel title="Architecture">
        <p class="flow-note mb-4">monorepo/</p>
        <ol class="flow flow-row">
          <li class="flow-step">
            <div class="flow-box">
              <p class="flow-name">client/ &nbsp;Next.js 14 · App Router</p>
              <p class="flow-note">Vercel</p>
              <p class="flow-note">CoinGecko (prices) · TradingView (charts)</p>
            </div>
          </li>
          <li class="flow-link">HTTP / JSON via Axios</li>
          <li class="flow-step">
            <div class="flow-box">
              <p class="flow-name">server/ &nbsp;Express REST API · MVC</p>
              <p class="flow-note">Render</p>
            </div>
          </li>
          <li class="flow-link">models → routes → controllers</li>
          <li class="flow-step">
            <div class="flow-box">
              <p class="flow-name">MongoDB + Mongoose</p>
            </div>
          </li>
        </ol>
      </Panel>
    </div>
  </section>

  <section class="cs-split">
    <h2 data-rise>The demo trading engine</h2>
    <div class="cs-main">
      <p data-rise style="--i: 1">
        Rather than storing a mutable balance that can drift out of sync, the engine treats every
        buy and sell as an immutable transaction in MongoDB. A user's current coin holdings and
        portfolio value are computed dynamically by replaying that transaction history — so the
        portfolio is always a provable function of what the user actually did, and never a number
        that can quietly go wrong.
      </p>
    </div>
  </section>

  <section class="cs-aside">
    <div class="cs-side">
      <h2 data-rise>Security</h2>
      <p data-rise style="--i: 1">The API is treated as a public surface and hardened accordingly.</p>
    </div>
    <div class="cs-main">
      <Panel>
        <div class="flex flex-col gap-3.5">
          {
            security.map((s) => (
              <div class="spec">
                <span class="spec-key">{s.k}</span>
                <span class="spec-val">{s.v}</span>
              </div>
            ))
          }
        </div>
      </Panel>
    </div>
  </section>

  <section class="cs-stage">
    <div class="cs-top">
      <h2 data-rise>Key features</h2>
    </div>
    <ul class="cs-figure cs-points cs-points-3" data-rise style="--i: 1">
      {features.map((f) => <li>{f}</li>)}
    </ul>
  </section>

  <section class="band band-b cs-stack">
    <h2 data-rise>Tech stack</h2>
    <div class="cs-group" data-rise style="--i: 1">
      <h3>Front end</h3>
      <ul>
        {frontendStack.map((t) => <li class="chip">{t}</li>)}
      </ul>
    </div>
    <div class="cs-group" data-rise style="--i: 2">
      <h3>Back end</h3>
      <ul>
        {backendStack.map((t) => <li class="chip">{t}</li>)}
      </ul>
    </div>
  </section>

  <section class="cs-open">
    <h2 data-rise>Outcome</h2>
    <div class="cs-main">
      <p data-rise style="--i: 1">
        Cryptofolio is deployed and used for portfolio tracking and risk-free practice trading. The
        replay-based engine and offloaded third-party calls keep the backend lean while the platform
        stays accurate — a focused tool that does one thing, dependably.
      </p>
    </div>
  </section>
</CaseStudyLayout>
