---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import Panel from '../../components/Panel.astro';
import { shots, SIZE } from '../../data/shots';

const wide = shots['prsnn'][2];
const tall = shots['prsnn'].filter((s) => s.kind === 'phone')[1];

const frontendStack = [
  'Next.js 16',
  'React 19',
  'Tailwind CSS v4',
  'PostCSS',
  'Axios',
  'Socket.io Client',
  'Sentry',
  'Vitest',
  'Testing Library',
  'ESLint v9',
];

const backendStack = [
  'Node.js (ESM)',
  'Express 5',
  'MongoDB',
  'Mongoose 9',
  'JWT',
  'Bcrypt',
  'Socket.io',
  'Razorpay',
  'Multer',
  'Cloudinary',
  'Resend',
  'Zod',
  'Helmet',
  'CORS',
  'express-rate-limit',
  'Sentry',
  'Vitest',
  'Supertest',
  'Nodemon',
  'Morgan',
];

const modes = [
  { name: "Don't Go Alone", desc: "Find a companion for an outing you'd rather not do solo." },
  { name: 'Sit With Me', desc: 'Quiet company — someone to simply be present alongside you.' },
  { name: 'Be Around', desc: 'Low-key presence nearby without a structured plan.' },
  { name: 'Explore Together', desc: 'Pair up to discover places and experiences in the city.' },
];

const stats = [
  { value: '4', label: 'cities live' },
  { value: '500+', label: 'users' },
  { value: '4.9/5', label: 'user rating' },
];

const features = [
  'Four discovery modes for different companionship needs',
  'Verified companion profiles to build trust',
  'Availability booking with a real-time slot system',
  'Secure payments integrated through Razorpay',
  'End-to-end companion onboarding flow',
  'User authentication and account management',
];
---

<CaseStudyLayout
  name="Prsnn"
  slug="prsnn"
  tagline="A peer-to-peer companion marketplace live across four Indian cities — 500+ users, a 4.9/5 rating, and a real-time availability system, built end-to-end as the sole developer."
  description="Case study of Prsnn, a peer-to-peer companion marketplace built with Next.js, Node.js, MongoDB, and Razorpay — live across Mumbai, Bangalore, Delhi, and Hyderabad."
  role="Sole Full Stack Developer"
  status="Live · 4 cities"
  stackSummary="Next.js · Node · MongoDB · Razorpay"
  live="https://www.prsnn.com/"
>
  <section class="cs-open">
    <h2 data-rise>Overview</h2>
    <div class="cs-main">
      <p data-rise style="--i: 1">
        Prsnn is a peer-to-peer companion marketplace — it connects people who want company for an
        outing, an errand, or simply for presence, with verified companions available near them. It
        is live across four Indian cities — Mumbai, Bangalore, Delhi, and Hyderabad — and has grown
        to 500+ users with a 4.9/5 rating.
      </p>
    </div>
    <div class="cs-plates">
      <figure class="cs-plate-wide" data-rise style="--i: 2">
        <img src={wide.src} alt={wide.alt} width={SIZE.desktop.width} height={SIZE.desktop.height} loading="lazy" decoding="async" />
      </figure>
      <figure class="cs-plate-tall" data-rise style="--i: 3">
        <img src={tall.src} alt={tall.alt} width={SIZE.phone.width} height={SIZE.phone.height} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="cs-stage">
    <div class="cs-top">
      <h2 data-rise>By the numbers</h2>
    </div>
    <dl class="cs-figure stats">
      {
        stats.map((s, i) => (
          <div data-rise style={`--i: ${i + 1}`}>
            <dt class="small muted">{s.label}</dt>
            <dd class="numeral">{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="cs-split">
    <h2 data-rise>The challenge</h2>
    <div class="cs-main">
      <p data-rise style="--i: 1">
        "Companionship" is not one need — sometimes people want an active partner to explore a
        city, sometimes just quiet presence. A single generic "book a person" flow flattens all of
        that. Prsnn needed discovery that respects those different intents, and — because it puts
        strangers in contact — trust and safety built in from the first screen.
      </p>
    </div>
  </section>

  <section class="cs-stage">
    <div class="cs-top">
      <h2 data-rise>Multi-mode discovery</h2>
      <p class="cs-intro" data-rise style="--i: 1">
        Instead of one search box, Prsnn offers four distinct modes, each shaping how companions are
        matched and presented:
      </p>
    </div>
    <ul class="cs-figure cs-items cs-items-4">
      {
        modes.map((m, i) => (
          <li data-rise style={`--i: ${i + 1}`}>
            <h3>{m.name}</h3>
            <p>{m.desc}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="cs-aside">
    <div class="cs-side">
      <h2 data-rise>Real-time availability</h2>
      <p data-rise style="--i: 1">
        Bookings only work if availability is honest. I built a real-time availability system on
        Socket.io so companion slots reflect the current state — when a slot is taken it disappears
        for everyone instantly, and users book against live data rather than a stale calendar.
        Verified profiles sit on top of this, so every bookable companion has been vetted.
      </p>
    </div>
    <div class="cs-main">
      <Panel title="Booking flow">
        <ol class="flow">
          {
            ['discover (mode)', 'verified profile', 'pick live slot', 'Razorpay payment', 'real-time availability', 'confirmed booking'].map((step, i) => (
              <>
                {i > 0 && <li class="flow-link" aria-hidden="true" />}
                <li class="flow-step">
                  <div class="flow-box">
                    <p class="flow-name">{step}</p>
                  </div>
                </li>
              </>
            ))
          }
        </ol>
      </Panel>
    </div>
  </section>

  <section class="cs-split">
    <h2 data-rise>Payments &amp; onboarding</h2>
    <div class="cs-main">
      <p data-rise style="--i: 1">
        Payments are handled through a secure Razorpay integration, so money changes hands inside a
        trusted, compliant flow. On the supply side, I built the full companion onboarding journey
        end-to-end — sign-up, verification, and going live — alongside user authentication for the
        people booking them.
      </p>
    </div>
  </section>

  <section class="cs-stage">
    <div class="cs-top">
      <h2 data-rise>Key features</h2>
    </div>
    <ul class="cs-figure cs-points cs-points-3" data-rise style="--i: 1">
      {features.map((f) => <li>{f}</li>)}
    </ul>
  </section>

  <section class="band band-b cs-stack">
    <h2 data-rise>Tech stack</h2>
    <div class="cs-group" data-rise style="--i: 1">
      <h3>Front end</h3>
      <ul>
        {frontendStack.map((t) => <li class="chip">{t}</li>)}
      </ul>
    </div>
    <div class="cs-group" data-rise style="--i: 2">
      <h3>Back end</h3>
      <ul>
        {backendStack.map((t) => <li class="chip">{t}</li>)}
      </ul>
    </div>
  </section>

  <section class="cs-open">
    <h2 data-rise>Outcome</h2>
    <div class="cs-main">
      <p data-rise style="--i: 1">
        Built solo and shipped to production, Prsnn reached 500+ users across four cities with a
        4.9/5 rating — evidence that thoughtful, intent-aware discovery and trust-first design
        resonate with real people, not just in a spec.
      </p>
    </div>
  </section>
</CaseStudyLayout>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 20px;
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
  }
  .stats dd {
    font-size: var(--step-display);
  }
  @media (max-width: 899px) {
    .stats dd {
      font-size: var(--step-head);
    }
  }
</style>
