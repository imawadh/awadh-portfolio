---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import Panel from '../../components/Panel.astro';

const techStack = [
  'Next.js v16',
  'React v19',
  'Tailwind CSS v4',
  'Framer Motion v12',
  'PostCSS',
  'Mongoose v9',
  'MongoDB',
  'Vercel Analytics',
  'ESLint v9',
  'Babel (React Compiler Plugin)',
];

const perf = [
  { k: 'SSR', v: 'Server-side rendering for fast first paint' },
  { k: 'assets', v: 'Compressed images and bundles' },
  { k: 'SEO', v: 'Semantic markup and metadata best practices' },
  { k: 'result', v: '~30% faster page loads' },
];

const features = [
  'Responsive learning experience across all devices',
  'Structured course content for competitive exams',
  'Server-side rendered pages for speed and SEO',
  'Stable performance at 1,500+ daily active users',
  'Cloud deployment with post-launch monitoring',
  'Solo end-to-end build, delivery, and maintenance',
];
---

<CaseStudyLayout
  name="The SRS Classes"
  slug="srs-classes"
  tagline="A responsive ed-tech platform for competitive-exam aspirants — shipped solo as a freelance contractor, serving 1,500+ daily active users with ~30% faster page loads."
  description="Case study of The SRS Classes, a responsive ed-tech web application built with Next.js and React, serving 1,500+ daily active users."
  role="Freelance Full Stack Developer"
  status="Live in production"
  stackSummary="Next.js · React · MongoDB"
  live="https://srsclasses.com/"
  code="https://github.com/imawadh/srs-website"
>
  <div slot="lead" class="srs-lead">
    <figure class="srs-figures">
      <dl class="srs-big">
        <div>
          <dt class="small muted">Page load time</dt>
          <dd class="numeral">&minus;30%</dd>
        </div>
        <div>
          <dt class="small muted">Daily active users</dt>
          <dd class="numeral">1,500+</dd>
        </div>
        <div>
          <dt class="small muted">SSR first paint</dt>
          <dd class="lead">Fast</dd>
        </div>
        <div>
          <dt class="small muted">Cross-device</dt>
          <dd class="lead">Stable</dd>
        </div>
      </dl>
      <figcaption class="small muted srs-cap">Performance</figcaption>
    </figure>
  </div>

  <section class="cs-open">
    <h2 data-rise>Overview</h2>
    <div class="cs-main">
      <p data-rise style="--i: 1">
        The SRS Classes is an educational web application for students preparing for competitive
        exams. I built and shipped it as a solo freelance contractor — from first feature to live
        deployment — and it now serves 1,500+ daily active users with stable, cross-device
        performance.
      </p>
    </div>
  </section>

  <section class="cs-split">
    <h2 data-rise>The challenge</h2>
    <div class="cs-main">
      <p data-rise style="--i: 1">
        Exam aspirants browse on whatever device they have, often on slow connections — and a sluggish
        learning platform quietly costs engagement. The site needed to feel fast and stay reliable as
        daily traffic climbed into the thousands, all delivered on a freelance timeline by one
        developer.
      </p>
    </div>
  </section>

  <section class="cs-aside">
    <div class="cs-side">
      <h2 data-rise>Performance work</h2>
      <p data-rise style="--i: 1">
        The headline result was a ~30% reduction in page load times. That came from a deliberate set
        of optimisations rather than one trick:
      </p>
    </div>
    <div class="cs-main">
      <Panel>
        <div class="flex flex-col gap-3.5">
          {
            perf.map((p) => (
              <div class="spec">
                <span class="spec-key">{p.k}</span>
                <span class="spec-val">{p.v}</span>
              </div>
            ))
          }
        </div>
      </Panel>
    </div>
  </section>

  <section class="cs-split">
    <h2 data-rise>Owning the lifecycle</h2>
    <div class="cs-main">
      <p data-rise style="--i: 1">
        As the sole contractor, I owned every stage: feature development, cloud deployment,
        monitoring, and post-launch maintenance. There was no team to hand off to — which meant
        decisions had to be sound the first time, and the codebase had to stay maintainable for the
        person who'd return to it: me.
      </p>
    </div>
  </section>

  <section class="cs-stage">
    <div class="cs-top">
      <h2 data-rise>Key features</h2>
    </div>
    <ul class="cs-figure cs-points cs-points-3" data-rise style="--i: 1">
      {features.map((f) => <li>{f}</li>)}
    </ul>
  </section>

  <section class="band band-b cs-stack">
    <h2 data-rise>Tech stack</h2>
    <div class="cs-group cs-group-wide" data-rise style="--i: 1">
      <ul>
        {techStack.map((t) => <li class="chip">{t}</li>)}
      </ul>
    </div>
  </section>

  <section class="cs-open">
    <h2 data-rise>Outcome</h2>
    <div class="cs-main">
      <p data-rise style="--i: 1">
        The SRS Classes is live and used daily by 1,500+ aspirants in their exam preparation. As a
        solo freelance engagement, it proved I can take a product from brief to production — and keep
        it fast and dependable once real users arrive.
      </p>
    </div>
  </section>
</CaseStudyLayout>

<style>
  .srs-lead {
    margin-top: clamp(3rem, 2rem + 4vw, 6rem);
    padding: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    background: var(--surface);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 20px;
    row-gap: 2.5rem;
    align-items: end;
  }
  .srs-figures {
    grid-column: 1 / span 8;
  }
  .srs-cap {
    margin-top: 1.5rem;
  }
  .srs-big {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 20px;
    row-gap: 2rem;
  }
  .srs-big div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.5rem;
  }
  .srs-big dd.numeral {
    font-size: var(--step-display);
    line-height: 0.9;
  }
  @media (max-width: 899px) {
    .srs-figures {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 559px) {
    .srs-big {
      grid-template-columns: 1fr;
    }
  }
</style>
