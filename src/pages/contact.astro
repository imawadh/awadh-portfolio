---
import PageLayout from '../layouts/PageLayout.astro';
import { socials } from '../utils/socials';
import { resumeUrl } from '../utils/site';

const email = 'awadhkishorsingh241@gmail.com';

const channels = [
  { key: 'Phone', value: '+91 79850 00241', href: 'tel:+917985000241' },
  { key: 'Location', value: 'Bengaluru, Karnataka, India', href: null },
];

const mailtoCompose = `mailto:${email}?subject=Let%27s%20work%20together&body=Hi%20Awadh%2C%0A%0A`;
---

<PageLayout
  title="Contact — Awadh Kishor Singh"
  description="Get in touch with Awadh Kishor Singh — Full Stack AI Developer in Bengaluru — for full-stack roles, freelance projects, or collaborations."
>
  <section class="wrap band-lead pb-14 md:pb-20">
    <h1 class="page-title reveal reveal-1">Say hello</h1>
    <p class="page-lede reveal reveal-2 mt-6 max-w-[44ch]">
      Open to internships, freelance work and good conversations across full-stack, software
      engineering and AI/ML. Email is the fastest way to reach me; I usually reply within a day.
    </p>

    <div class="reveal reveal-3 mt-12 md:mt-16">
      <a href={`mailto:${email}`} class="contact-email">{email}</a>
    </div>

    <div class="reveal reveal-4 mt-8 flex flex-wrap items-center gap-3">
      <a href={mailtoCompose} class="btn btn-primary">Open mail client</a>
      <button type="button" class="copy-btn btn btn-ghost" data-copy={email}>
        Copy address
      </button>
      <p class="ui m-0 inline-flex items-center gap-2.5 text-[1rem] text-[var(--signal)] sm:ml-3">
        <span class="pulse"></span>
        Accepting messages
      </p>
    </div>
  </section>

  <section class="wrap band band-b">
    <div class="split">
      <div class="split-head">
        <h2 class="m-0">Other ways to reach me</h2>
        <p>If email isn&rsquo;t your thing.</p>
      </div>

      <dl class="m-0 border-t border-[var(--border-bright)]">
        {
          channels.map((c) => (
            <div class="grid gap-1 border-b border-[var(--border)] py-4 sm:grid-cols-[10rem_1fr] sm:gap-6">
              <dt class="ui text-[1rem] font-semibold text-[var(--fg)]">{c.key}</dt>
              <dd class="ui m-0 text-[1.05rem] text-[var(--fg-dim)]">
                {c.href ? (
                  <a href={c.href} class="channel-link">
                    {c.value}
                  </a>
                ) : (
                  c.value
                )}
              </dd>
            </div>
          ))
        }
        <div class="grid gap-1 border-b border-[var(--border)] py-4 sm:grid-cols-[10rem_1fr] sm:gap-6">
          <dt class="ui text-[1rem] font-semibold text-[var(--fg)]">Elsewhere</dt>
          <dd class="ui m-0">
            <ul class="flex flex-wrap gap-x-6 gap-y-1">
              {
                socials.map((social) => (
                  <li>
                    <a
                      href={social.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="channel-link text-[1.05rem]"
                    >
                      {social.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </dd>
        </div>
        <div class="grid gap-1 border-b border-[var(--border)] py-4 sm:grid-cols-[10rem_1fr] sm:gap-6">
          <dt class="ui text-[1rem] font-semibold text-[var(--fg)]">Résumé</dt>
          <dd class="ui m-0 text-[1.05rem]">
            <a href={resumeUrl} target="_blank" rel="noopener noreferrer" class="channel-link">
              Download my résumé
            </a>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="wrap band band-a">
    <div class="split">
      <div class="split-head">
        <h2 class="m-0">Availability</h2>
        <p>What I&rsquo;m open to right now.</p>
      </div>

      <p class="m-0 max-w-[56ch] text-[1.2rem] leading-[1.65] text-[var(--fg)]">
        Currently available for internships and freelance work across full-stack, software
        engineering and AI/ML. Based in Bengaluru and happy to work remotely.
      </p>
    </div>
  </section>
</PageLayout>

<style>
  /* The address is the page: big Bricolage, cherry, underlined. */
  .contact-email {
    display: inline-block;
    max-width: 100%;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 5.6vw, 4rem);
    font-weight: 600;
    font-variation-settings: 'wdth' 82;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.16em;
    overflow-wrap: anywhere;
    transition: text-decoration-thickness 0.15s ease;
  }
  .contact-email:hover {
    text-decoration-thickness: 4px;
  }
  .channel-link {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--border-bright);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition:
      color 0.2s ease,
      text-decoration-color 0.2s ease;
  }
  .channel-link:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  @media (pointer: coarse) {
    .channel-link {
      display: inline-flex;
      min-height: 44px;
      align-items: center;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy;
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const original = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(() => {
          btn.textContent = original;
        }, 1600);
      } catch {
        /* clipboard unavailable — no-op */
      }
    });
  });
</script>
