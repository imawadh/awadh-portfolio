---
import PageLayout from '../layouts/PageLayout.astro';
import { socials } from '../utils/socials';
import { resumeUrl } from '../utils/site';
import { projects } from '../data/projects';
import { shots, SIZE } from '../data/shots';

const email = 'awadhkishorsingh241@gmail.com';
const [emailUser, emailHost] = email.split('@');

// Ways to reach me, as two-ended rows: label left, value right.
const channels = [
  { key: 'Email', value: email, href: `mailto:${email}`, external: false },
  { key: 'Phone', value: '+91 79850 00241', href: 'tel:+917985000241', external: false },
  { key: 'Location', value: 'Bengaluru, Karnataka, India', href: null, external: false },
];

// One screen from each live product, for a last look before writing.
const recent = ['prsnn', 'prescripto', 'axiora-learning', 'evaa', 'cryptofolio'].map((slug) => {
  const p = projects.find((x) => x.slug === slug)!;
  return { name: p.name, href: p.caseStudy, shot: shots[slug][0] };
});

const mailtoCompose = `mailto:${email}?subject=Let%27s%20work%20together&body=Hi%20Awadh%2C%0A%0A`;
---

<PageLayout
  title="Contact — Awadh Kishor Singh"
  description="Get in touch with Awadh Kishor Singh — Full Stack AI Developer in Bengaluru — for full-stack roles, freelance projects, or collaborations."
>
  <!-- ───────────── LEAD: the address is the page ───────────── -->
  <section class="wrap lead-sec" aria-labelledby="contact-title">
    <h1 id="contact-title" class="email-h reveal reveal-1">
      <span class="lead block">Say hello</span>
      <a href={`mailto:${email}`} class="email mt-4 inline-block">{emailUser}<wbr />@{emailHost}</a>
    </h1>

    <div class="grid-12 lead-grid">
      <div class="lead-main">
        <p class="page-lede reveal reveal-2 max-w-[40ch]">
          Open to internships, freelance work, and good conversations — full-stack, software
          engineering and AI/ML. The fastest way to reach me is email — I usually reply within a day.
        </p>

        <div class="compose reveal reveal-3 mt-8">
          <h2 class="lead">Compose a message</h2>
          <dl class="mt-2">
            <div class="row"><dt>To</dt><dd class="muted">{email}</dd></div>
            <div class="row"><dt>Subject</dt><dd class="muted">Let&rsquo;s work together</dd></div>
          </dl>
        </div>

        <div class="reveal reveal-3 mt-6 flex flex-wrap items-center gap-3">
          <a href={mailtoCompose} class="btn btn-primary">Open mail client</a>
          <button type="button" class="copy-btn btn" data-copy={email}>Copy</button>
          <span class="copy-status small muted" aria-live="polite" data-copy-status></span>
        </div>
      </div>

      <div class="lead-side reveal reveal-3">
        <img
          class="studio"
          src="https://awadh-portfolio-website.s3.ap-south-1.amazonaws.com/images/awadh-about.webp"
          alt="Portrait of Awadh Kishor Singh"
          width="320"
          height="320"
          loading="eager"
        />
        <div class="availability">
          <h2 class="lead">Availability</h2>
          <p class="small mt-2 inline-flex items-center gap-2.5">
            <span class="pulse"></span>Accepting messages
          </p>
          <p class="mt-3">
            Currently available for internships and freelance work — full-stack, software
            engineering and AI/ML. Based in Bengaluru, happy to work remotely.
          </p>
          <a href={resumeUrl} target="_blank" rel="noopener noreferrer" class="link mt-4 inline-flex">
            Download résumé &darr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────── OTHER CHANNELS: two-ended rows ───────────── -->
  <section class="wrap section grid-12 channels" aria-labelledby="channels-title">
    <div class="channels-head">
      <h2 id="channels-title" data-rise>Elsewhere</h2>
      <div class="mt-6 flex flex-wrap gap-2" data-rise style="--i: 1">
        {
          socials.map((social) => (
              <a href={social.url} target="_blank" rel="noopener noreferrer" class="chip">
                {social.label}
              </a>
            ))
        }
      </div>
    </div>

    <dl class="rows" data-rise style="--i: 2">
      {
        channels.map((c) => (
          <div class="row">
            <dt>{c.key}</dt>
            <dd class="muted">
              {c.href ? (
                <a
                  href={c.href}
                  class="row-link"
                  {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {c.value}
                </a>
              ) : (
                c.value
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- ───────────── RECENT WORK: one frame per product ───────────── -->
  <section class="wrap section recent" aria-labelledby="recent-title">
    <div class="recent-head">
      <h2 id="recent-title" data-rise>Selected work</h2>
      <a href="/projects" class="link" data-rise style="--i: 1">All work &rarr;</a>
    </div>
    <ul class="recent-row">
      {
        recent.map((r, i) => (
          <li data-rise style={`--i: ${i}`}>
            <a href={r.href} aria-label={`${r.name} case study`}>
              <img
                src={r.shot.src}
                alt={r.shot.alt}
                width={SIZE.desktop.width}
                height={SIZE.desktop.height}
                loading="lazy"
                decoding="async"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</PageLayout>

<style>
  .section {
    margin-top: var(--section-gap);
  }

  /* ── LEAD ── */
  .lead-sec {
    padding-top: clamp(2rem, 1.5rem + 3vw, 5rem);
  }
  /* The address at display size, breaking before the @ if it must;
     on a phone it drops to the head size so it never splits mid-name. */
  .email-h {
    font-size: var(--step-display);
    line-height: 1;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }
  .email {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.14em;
    text-decoration-color: var(--muted);
    transition:
      color 0.2s ease,
      text-decoration-color 0.2s ease;
  }
  .email:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  .lead-grid {
    row-gap: 3rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    align-items: start;
  }
  .lead-main {
    grid-column: 1 / span 6;
  }
  .lead-side {
    grid-column: 8 / span 5;
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }
  .studio {
    flex: none;
    width: 160px;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center 20%;
  }
  .copy-status:empty {
    display: none;
  }

  /* ── CHANNELS ── */
  .channels {
    align-items: start;
    row-gap: 2.5rem;
  }
  .channels-head {
    grid-column: 1 / span 5;
  }
  .rows {
    grid-column: 7 / span 6;
  }
  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 48px;
    padding: 8px 0;
  }
  .row dd {
    text-align: right;
    overflow-wrap: anywhere;
  }
  .row-link {
    color: var(--ink);
    transition: color 0.2s ease;
  }
  .row-link:hover {
    color: var(--accent);
  }

  /* ── TABLET AND PHONE ── */
  @media (max-width: 899px) {
    .lead-main,
    .lead-side,
    .channels-head,
    .rows {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 599px) {
    .email-h {
      font-size: var(--step-head);
    }
  }
  @media (max-width: 479px) {
    .studio {
      width: 96px;
    }
  }

  /* ── RECENT WORK ── */
  .recent-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 3rem;
  }
  .recent-row {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 8px;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }
  .recent-row img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    background: var(--surface);
    transition: filter 0.35s var(--ease-out);
  }
  .recent-row:has(a:hover) a:not(:hover) img {
    filter: brightness(0.4);
  }
  @media (max-width: 899px) {
    .recent-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .recent-row li:first-child {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy;
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const original = btn.textContent;
        btn.textContent = 'Copied';
        if (status) status.textContent = 'Copied';
        setTimeout(() => {
          btn.textContent = original;
          if (status) status.textContent = '';
        }, 1600);
      } catch {
        /* clipboard unavailable — no-op */
      }
    });
  });
</script>
