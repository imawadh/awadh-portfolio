---
import PageLayout from '../layouts/PageLayout.astro';
import Panel from '../components/Panel.astro';
import { socials } from '../utils/socials';
import { resumeUrl } from '../utils/site';

const channels = [
  {
    key: 'Email',
    value: 'awadhkishorsingh241@gmail.com',
    href: 'mailto:awadhkishorsingh241@gmail.com',
    copy: true,
  },
  { key: 'Phone', value: '+91 79850 00241', href: 'tel:+917985000241', copy: false },
  { key: 'Location', value: 'Bengaluru, Karnataka, India', href: null, copy: false },
];

const mailtoCompose =
  'mailto:awadhkishorsingh241@gmail.com?subject=Let%27s%20work%20together&body=Hi%20Awadh%2C%0A%0A';
---

<PageLayout
  title="Contact — Awadh Kishor Singh"
  description="Get in touch with Awadh Kishor Singh — Full Stack AI Developer in Bengaluru — for full-stack roles, freelance projects, or collaborations."
>
  <section class="wrap band band-a band-lead">
    <span class="eyebrow reveal reveal-1">Contact</span>
    <h1 class="reveal reveal-2 mt-6 max-w-[10ch]">Say hello</h1>
    <p
      class="reveal reveal-2 mt-7 max-w-[46ch] text-2xl leading-[1.3] text-[var(--fg-dim)] md:text-[1.9rem]"
      style="font-family:var(--font-display);font-weight:400;letter-spacing:-0.028em;"
    >
      Open to internships, freelance work, and good conversations — full-stack, software engineering and AI/ML.
      The fastest way to reach me is email — I usually reply within a day.
    </p>

  </section>

  <section class="wrap band band-b">
    <div class="reveal reveal-3 grid gap-12 md:grid-cols-[1.1fr_1fr] md:gap-16">
      <!-- Channels -->
      <div>
        <dl class="m-0 border-t border-[var(--fg)]">
          {
            channels.map((c) => (
              <div class="flex items-baseline justify-between gap-5 border-b border-[var(--border)] py-5">
                <div class="min-w-0">
                  <dt class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-[var(--accent)]">
                    {c.key}
                  </dt>
                  {c.href ? (
                    <dd class="m-0 mt-1.5">
                      <a
                        href={c.href}
                        class="break-all text-[1.02rem] text-[var(--fg)] transition-colors hover:text-[var(--accent)]"
                      >
                        {c.value}
                      </a>
                    </dd>
                  ) : (
                    <dd class="m-0 mt-1.5 text-[1.02rem] text-[var(--fg)]">{c.value}</dd>
                  )}
                </div>
                {c.copy && (
                  <button
                    type="button"
                    class="copy-btn shrink-0 font-mono text-[0.62rem] uppercase tracking-[0.16em] text-[var(--muted)] transition-colors hover:text-[var(--accent)]"
                    data-copy={c.value}
                  >
                    Copy
                  </button>
                )}
              </div>
            ))
          }
        </dl>

        <!-- Socials -->
        <div class="mt-10">
          <p class="kicker mb-4">Elsewhere</p>
          <div class="flex flex-wrap gap-2">
            {
              socials.map((social) => (
                <a href={social.url} target="_blank" rel="noopener noreferrer" class="chip">
                  {social.label}
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Compose + availability -->
      <div class="flex flex-col gap-6">
        <Panel title="Compose a message">
          <dl class="m-0 flex flex-col gap-3.5">
            <div class="spec">
              <span class="spec-key">To</span>
              <span class="spec-val">awadhkishorsingh241@gmail.com</span>
            </div>
            <div class="spec">
              <span class="spec-key">Subject</span>
              <span class="spec-val">Let&rsquo;s work together</span>
            </div>
            <div class="spec">
              <span class="spec-key">Status</span>
              <span class="spec-val inline-flex items-center gap-2.5 text-[var(--signal)]">
                <span class="pulse"></span>
                Accepting messages
              </span>
            </div>
          </dl>
          <a href={mailtoCompose} class="btn btn-primary mt-7 w-full justify-center">
            Open mail client
          </a>
        </Panel>

        <div class="border-t border-[var(--fg)] pt-7">
          <p class="kicker">Availability</p>
          <p class="m-0 mt-3 text-[0.98rem] leading-relaxed text-[var(--fg-dim)]">
            Currently <span class="text-[var(--accent)]">available</span> for internships
            and freelance work — full-stack, software engineering and AI/ML. Based in Bengaluru,
            happy to work remotely.
          </p>
          <a
            href={resumeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-5 inline-flex font-mono text-[0.66rem] uppercase tracking-[0.16em] text-[var(--accent)] transition-opacity hover:opacity-70"
          >
            Download résumé &darr;
          </a>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy;
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const original = btn.textContent;
        btn.textContent = 'Copied ✓';
        btn.style.color = 'var(--accent)';
        setTimeout(() => {
          btn.textContent = original;
          btn.style.color = '';
        }, 1600);
      } catch {
        /* clipboard unavailable — no-op */
      }
    });
  });
</script>
