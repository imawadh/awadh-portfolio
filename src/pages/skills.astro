---
import PageLayout from '../layouts/PageLayout.astro';
import SkillCard from '../components/SkillCard.astro';

const skillsData = [
  {
    index: '01',
    category: 'Languages',
    note: 'The languages I write day to day, across web, systems, and data work.',
    skills: ['Python', 'C++', 'Java', 'JavaScript (ES6+)', 'TypeScript', 'SQL', 'HTML5', 'CSS3'],
  },
  {
    index: '02',
    category: 'Frontend',
    note: 'Component systems, routing, and interface work that stays fast on real devices.',
    skills: [
      'React.js',
      'Next.js',
      'TypeScript',
      'Tailwind CSS',
      'Framer Motion',
      'Responsive Web Design',
    ],
  },
  {
    index: '03',
    category: 'Backend',
    note: 'APIs, services, and the server-side architecture products actually run on.',
    skills: [
      'Node.js',
      'Express.js',
      'NestJS',
      'Django',
      'Flask',
      'Socket.io',
      'REST API Development',
    ],
  },
  {
    index: '04',
    category: 'Databases',
    note: 'Relational and document stores, modelled for the queries a product needs.',
    skills: ['MongoDB', 'MySQL', 'PostgreSQL', 'Prisma', 'Mongoose'],
  },
  {
    index: '05',
    category: 'Core CS',
    note: 'The fundamentals behind every architectural decision I make.',
    skills: [
      'Data Structures & Algorithms',
      'OOP',
      'System Design',
      'Scalable Architecture',
      'API Security',
    ],
  },
  {
    index: '06',
    category: 'Machine Learning & AI',
    note: 'Applied machine learning — training and shipping models that drive product features.',
    skills: ['Python', 'scikit-learn', 'Applied ML model training', 'LLMs'],
  },
  {
    index: '07',
    category: 'Monitoring & Analytics',
    note: 'How I know a product works once it leaves my machine.',
    skills: ['Mixpanel', 'PostHog', 'Google Analytics', 'Sentry'],
  },
  {
    index: '08',
    category: 'Tools & Platforms',
    note: 'Where the code is written, deployed, paid for, and kept alive.',
    skills: [
      'Git',
      'GitHub',
      'Postman',
      'Linux',
      'VS Code',
      'Vercel',
      'Render',
      'AWS Amplify',
      'AWS EC2',
      'Razorpay',
    ],
  },
  {
    index: '09',
    category: 'Currently learning',
    note: 'Extending the same end-to-end approach to mobile — first app in development.',
    skills: ['Android', 'iOS', 'Mobile development'],
  },
];

const allSkills = [...new Set(skillsData.flatMap((c) => c.skills))];
---

<PageLayout
  title="Skills & Technologies — Awadh Kishor Singh"
  description="The full tech stack of Awadh Kishor Singh — React, Next.js, TypeScript, Node.js, Express, NestJS, MongoDB, PostgreSQL, Python, scikit-learn, AWS, and the tools behind production web apps."
>
  <section class="wrap band band-a band-lead">
    <span class="eyebrow reveal reveal-1">Skills</span>
    <h1 class="reveal reveal-2 mt-6 max-w-[11ch]">The working stack</h1>
    <p
      class="reveal reveal-2 mt-7 max-w-[48ch] text-2xl leading-[1.3] text-[var(--fg-dim)] md:text-[1.9rem]"
      style="font-family:var(--font-display);font-weight:400;letter-spacing:-0.028em;"
    >
      The languages, frameworks, and tools I reach for across full-stack development — from shipping
      UI to securing APIs to monitoring what happens in production.
    </p>

  </section>

  <section class="wrap band band-b">
    <div class="reveal reveal-3 grid gap-6 md:grid-cols-2">
      {
        skillsData.map((group) => (
          <SkillCard
            index={group.index}
            category={group.category}
            note={group.note}
            skills={group.skills}
          />
        ))
      }
    </div>

  </section>

  <section class="wrap band band-c">
    <!-- Marquee -->
    <div class="reveal reveal-4">
      <p class="kicker mb-4">Everything, in one line</p>
      <div class="overflow-hidden border-y border-[var(--border)] py-5">
        <div class="marquee-track flex gap-3">
          {allSkills.map((skill) => <span class="chip shrink-0 whitespace-nowrap">{skill}</span>)}
          {allSkills.map((skill) => <span class="chip shrink-0 whitespace-nowrap">{skill}</span>)}
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .marquee-track {
    width: max-content;
    animation: marquee 46s linear infinite;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-50% - 0.375rem));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
    }
  }
</style>
