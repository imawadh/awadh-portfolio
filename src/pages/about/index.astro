---
import PageLayout from '../../layouts/PageLayout.astro';

const facts = [
  { key: 'Stack', value: 'Next.js · React · NestJS · Node · Express · PostgreSQL · MongoDB' },
  { key: 'Currently', value: 'Open to internships & freelance work' },
  { key: 'Building', value: 'First mobile app — Android & iOS, releasing soon' },
  { key: 'Recently', value: 'Full Stack Developer Intern @ IAVerse (Remote)' },
  { key: 'Education', value: 'BS Data Science, IIT Madras · CGPA 8.27' },
  { key: 'Algorithms', value: '1,000+ DSA problems · LeetCode & Codeforces' },
];

const principles = [
  {
    title: 'Ship end-to-end',
    body: 'I work across the whole stack — UI, API, database, deployment — so a feature is done when it is live and working, not when the PR merges.',
  },
  {
    title: 'Build for scale',
    body: 'Scalable architecture, clean component systems, and API security are decisions I make early, not patches I add when something breaks.',
  },
  {
    title: 'Mind the invisible',
    body: 'Analytics, error monitoring, and performance budgets matter as much as the visible UI — they are how you actually know a product works.',
  },
];

const quickNav = [
  { label: 'Experience', href: '/experience' },
  { label: 'Work', href: '/projects' },
  { label: 'Skills', href: '/skills' },
  { label: 'Contact', href: '/contact' },
];
---

<PageLayout
  title="About — Awadh Kishor Singh"
  description="About Awadh Kishor Singh — Full Stack AI Developer in Bengaluru and Data Science undergraduate at IIT Madras, building production-ready web applications end-to-end, with applied ML experience and a first mobile app in progress."
>
  <section class="wrap band band-a band-lead">
    <span class="eyebrow reveal reveal-1">About</span>
    <h1 class="reveal reveal-2 mt-6 max-w-[12ch]">The person behind the commits</h1>
    <p
      class="reveal reveal-2 mt-7 max-w-[46ch] text-2xl leading-[1.3] text-[var(--fg-dim)] md:text-[1.9rem]"
      style="font-family:var(--font-display);font-weight:400;letter-spacing:-0.028em;"
    >
      Full Stack AI Developer based in Bengaluru — building web apps that hold up with real users, real
      traffic, and real deadlines.
    </p>

  </section>

  <section class="wrap band band-b">
    <div class="reveal reveal-3 grid gap-12 md:grid-cols-[320px_1fr] md:items-start md:gap-16">
      <!-- Portrait plate -->
      <figure class="plate md:sticky md:top-28">
        <img
          src="https://awadh-portfolio-website.s3.ap-south-1.amazonaws.com/images/sitting-image.webp"
          alt="Awadh Kishor Singh"
          loading="eager"
          width="600"
          height="800"
          class="aspect-[3/4] object-cover object-top"
        />
        <figcaption class="plate-caption">
          <span>Awadh Kishor Singh</span>
          <span class="inline-flex items-center gap-2">
            <span class="pulse"></span>
            Open
          </span>
        </figcaption>
      </figure>

      <!-- Bio -->
      <div class="flex flex-col gap-6">
        <p
          class="m-0 text-[1.15rem] leading-[1.7] text-[var(--fg)] md:text-[1.22rem]"
          style="font-family:var(--font-display);font-weight:400;letter-spacing:-0.028em;"
        >
          I&rsquo;m a Full Stack AI Developer and a Data Science undergraduate at
          <span class="link">IIT Madras</span>. I design, build, and ship production-ready web
          applications — most recently as a Full Stack Developer Intern at
          <span class="text-[var(--accent)]">IAVerse</span>.
        </p>
        <p class="m-0 leading-[1.78] text-[var(--fg-dim)]">
          My recent work spans a 1,200+ page WordPress-to-Next.js migration at IAVerse, a workforce
          alignment platform at KaiKa AI where I also trained the machine learning model behind its
          scoring engine, a freelance ed-tech platform serving 1,500+ daily active users, and a
          peer-to-peer marketplace live across four Indian cities. I work the whole stack: React and
          Next.js on the front, Node.js and Express REST APIs on the back, MongoDB and PostgreSQL for
          data, deployed on Vercel, Render, and AWS.
        </p>
        <p class="m-0 leading-[1.78] text-[var(--fg-dim)]">
          I care about the parts users never see — product analytics with Mixpanel and PostHog, error
          monitoring with Sentry, API security, and architecture that scales. Alongside building,
          I&rsquo;ve solved 1,000+ Data Structures &amp; Algorithms problems on LeetCode and
          Codeforces, with a focus on Trees, Graphs, and Dynamic Programming.
        </p>
        <p class="m-0 leading-[1.78] text-[var(--fg-dim)]">
          Right now I&rsquo;m extending that into mobile — learning Android and iOS development, with
          a first app in progress and a release planned soon. I&rsquo;m open to software engineering,
          full-stack and AI/ML roles, and to internship and freelance opportunities.
        </p>

        <!-- Facts -->
        <dl class="m-0 mt-4 border-t border-[var(--fg)]">
          {
            facts.map((f) => (
              <div class="flex flex-col gap-1 border-b border-[var(--border)] py-4 sm:flex-row sm:gap-6">
                <dt class="w-32 shrink-0 pt-0.5 font-mono text-[0.62rem] uppercase tracking-[0.18em] text-[var(--accent)]">
                  {f.key}
                </dt>
                <dd class="m-0 text-[0.97rem] text-[var(--fg)]">{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

  </section>

  <section class="wrap band band-c">
    <!-- Principles -->
    <div class="reveal reveal-4">
      <div class="section-head">
        <div>
          <span class="section-no">01</span>
          <h2 class="mt-3">How I work</h2>
        </div>
      </div>
      <div class="mt-10 grid gap-x-12 gap-y-10 md:grid-cols-3">
        {
          principles.map((p, i) => (
            <div class="border-t border-[var(--border)] pt-6">
              <span class="font-mono text-[0.64rem] tracking-[0.19em] text-[var(--accent)]">
                0{i + 1}
              </span>
              <h3 class="mt-3 text-xl">{p.title}</h3>
              <p class="m-0 mt-3 text-[0.95rem] leading-relaxed text-[var(--fg-dim)]">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>

  </section>

  <section class="wrap band band-a">
    <!-- Quick nav -->
    <div class="flex flex-wrap gap-3">
      {quickNav.map((n) => <a href={n.href} class="btn btn-ghost">{n.label}</a>)}
    </div>
  </section>
</PageLayout>
