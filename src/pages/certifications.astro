---
import PageLayout from '../layouts/PageLayout.astro';
import CertCard from '../components/CertCard.astro';

const certifications = [
  {
    index: '01',
    date: 'Jan 2026',
    title: 'The Complete Full-Stack Web Development Bootcamp',
    issuer: 'Dr. Angela Yu · Udemy',
    details: '70 hours — REST API design, backend architecture, SQL & NoSQL databases',
    url: 'https://www.udemy.com/certificate/UC-16b07d74-aa19-45d3-924c-41b9e7fae772/',
  },
  {
    index: '02',
    date: 'Apr 2025',
    title: 'Python Certification',
    issuer: 'Intellipaat',
    details: 'Professional Python programming certification',
    url: 'https://intellipaat.com/academy/certificate-link/?Yz0xNTQzJnU9MTY2Njk4JmV4dD0x',
  },
  {
    index: '03',
    date: 'Mar 2025',
    title: 'Mathematics for Data Science & ML Bootcamp',
    issuer: 'Krish Naik · Udemy',
    details: 'Mathematical foundations for machine learning',
    url: 'https://www.udemy.com/certificate/UC-d4ef6961-95f9-4912-be28-c2c0cf02974a/',
  },
  {
    index: '04',
    date: 'Jan 2025',
    title: 'Complete Data Analysis Bootcamp',
    issuer: 'Krish Naik · Udemy',
    details: 'Comprehensive data analysis training',
    url: 'https://www.udemy.com/certificate/UC-1590fb55-374f-406a-8285-014f7a1b1088/',
  },
];

const achievements = [
  {
    value: '1,000+',
    label: 'DSA problems solved',
    note: 'LeetCode & Codeforces — Trees, Graphs, Dynamic Programming',
  },
  {
    value: '2,100+',
    label: 'GitHub commits',
    note: 'Across personal projects, freelance work, and internship contributions',
  },
];
---

<PageLayout
  title="Certifications & Achievements — Awadh Kishor Singh"
  description="Certifications and achievements of Awadh Kishor Singh — full-stack web development, Python, data science, 1,000+ DSA problems, and 2,100+ GitHub commits."
>
  <section class="wrap band band-a band-lead">
    <span class="eyebrow reveal reveal-1">Credentials</span>
    <h1 class="reveal reveal-2 mt-6 max-w-[13ch]">Proof of the work</h1>
    <p
      class="reveal reveal-2 mt-7 max-w-[48ch] text-2xl leading-[1.3] text-[var(--fg-dim)] md:text-[1.9rem]"
      style="font-family:var(--font-display);font-weight:400;letter-spacing:-0.028em;"
    >
      Verified certifications and measurable achievements from continuous learning across full-stack
      development, Python, and data science.
    </p>

  </section>

  <section class="wrap band band-b">
    <!-- Achievements -->
    <div class="reveal reveal-3">
      <div class="section-head">
        <div>
          <span class="section-no">01</span>
          <h2 class="mt-3">Achievements</h2>
        </div>
      </div>
      <div class="grid gap-x-12 md:grid-cols-2">
        {
          achievements.map((a) => (
            <div class="border-b border-[var(--border)] py-8">
              <span class="numeral block text-5xl text-[var(--accent)] md:text-6xl">{a.value}</span>
              <p class="m-0 mt-4 text-lg text-[var(--fg)]" style="font-family:var(--font-display);font-weight:600;letter-spacing:-0.022em;">
                {a.label}
              </p>
              <p class="m-0 mt-1.5 text-[0.92rem] text-[var(--muted)]">{a.note}</p>
            </div>
          ))
        }
      </div>
    </div>

  </section>

  <section class="wrap band band-c">
    <!-- Certifications -->
    <div class="reveal reveal-4">
      <div class="section-head">
        <div>
          <span class="section-no">02</span>
          <h2 class="mt-3">Certifications</h2>
        </div>
        <span class="hidden shrink-0 pb-1 font-mono text-[0.64rem] uppercase tracking-[0.16em] text-[var(--muted)] sm:inline">
          {certifications.length} verified
        </span>
      </div>
      <div class="mt-4 flex flex-col">
        {
          certifications.map((cert) => (
            <CertCard
              index={cert.index}
              date={cert.date}
              title={cert.title}
              issuer={cert.issuer}
              details={cert.details}
              url={cert.url}
            />
          ))
        }
      </div>
    </div>
  </section>
</PageLayout>
