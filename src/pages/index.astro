---
import PageLayout from '../layouts/PageLayout.astro';
import { projects, featuredProjects } from '../data/projects';
import { shots, SIZE, type Shot } from '../data/shots';
import { socials } from '../utils/socials';
import { resumeUrl } from '../utils/site';

// Hero strip: the first screens of every product, interleaved so no two
// neighbouring frames come from the same site.
const pick = (slug: string, i: number) => ({ ...shots[slug][i], slug, name: projects.find((p) => p.slug === slug)!.name });
const strip = [
  pick('axiora-learning', 0),
  pick('prsnn', 5),
  pick('evaa', 0),
  pick('prescripto', 0),
  pick('cryptofolio', 0),
  pick('prsnn', 0),
  pick('evaa', 5),
  pick('axiora-learning', 1),
  pick('prescripto', 5),
  pick('evaa', 2),
  pick('cryptofolio', 2),
  pick('prsnn', 1),
  pick('prescripto', 2),
  pick('evaa', 1),
];

const work = featuredProjects.map((p) => ({ ...p, frames: shots[p.slug] ?? [] }));

const stats = [
  { whole: '1,000+', frac: '', label: 'DSA problems solved' },
  { whole: '2,100+', frac: '', label: 'GitHub commits' },
  { whole: '6', frac: '', label: 'Products shipped' },
  { whole: '8', frac: '.27', label: 'CGPA · IIT Madras' },
];

const profile = [
  { key: 'Name', value: 'Awadh Kishor Singh' },
  { key: 'Alias', value: 'imawadh · im_awadh_' },
  { key: 'Role', value: 'Full Stack AI Developer' },
  { key: 'Education', value: 'BS Data Science, IIT Madras' },
  { key: 'Based', value: 'Bengaluru, India · Remote-friendly' },
  { key: 'Stack', value: 'React · Next.js · NestJS · Node.js · PostgreSQL · AWS' },
  { key: 'Recently', value: 'Full Stack Developer Intern, IAVerse' },
  { key: 'Learning', value: 'Android & iOS — first app releasing soon' },
];
const sideKeys = ['Role', 'Education', 'Based'];
const sideFacts = profile.filter((f) => sideKeys.includes(f.key));
const restFacts = profile.filter((f) => !sideKeys.includes(f.key));

const ratio = (s: Shot) => `${SIZE[s.kind].width} / ${SIZE[s.kind].height}`;
---

<PageLayout
  title="Awadh Kishor Singh | Full Stack AI Developer"
  description="Awadh Kishor Singh — Full Stack AI Developer in Bengaluru building production-ready web apps with React, Next.js, NestJS and Node.js, with applied ML and LLM experience. Data Science undergraduate at IIT Madras, open to internships and freelance work."
>
  <!-- ───────────── HERO: the name, then a lit strip of the work ───────────── -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <h1 id="hero-title" class="hero-name">Awadh Kishor Singh</h1>

      <div class="hero-notes grid-12 small">
        <p class="note-1">Full Stack AI Developer</p>
        <p class="note-2 muted">BS Data Science, IIT Madras. Bengaluru, India · Remote-friendly</p>
        <p class="note-3 inline-flex items-start gap-2.5"><span class="pulse mt-[0.4em]"></span>Open to internships &amp; freelance work</p>
        <p class="note-4 flex flex-wrap gap-x-4">
          {
            socials.map((s) => (
              <a class="link" href={s.url} target="_blank" rel="noopener noreferrer">
                {s.label}
              </a>
            ))
          }
        </p>
      </div>
    </div>

    <div class="strip" data-strip aria-label="Selected work">
      {
        strip.map((f, i) => (
          <figure class="frame" data-frame data-name={f.name}>
            <a href={`/projects/${f.slug}`} tabindex="-1" aria-hidden="true">
              <img
                src={f.src}
                alt={f.alt}
                width={SIZE[f.kind].width}
                height={SIZE[f.kind].height}
                style={`aspect-ratio: ${ratio(f)}`}
                loading={i < 6 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </a>
          </figure>
        ))
      }
    </div>

    <p class="strip-title small" data-strip-title aria-live="polite">EVAA Enterprises</p>

    <div class="wrap hero-foot">
      <p class="lead max-w-[32ch]">Full Stack AI Developer building production-ready web apps.</p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href="/projects" class="btn btn-primary">View work</a>
        <a href={resumeUrl} target="_blank" rel="noopener noreferrer" class="btn">Résumé</a>
        <a href="/contact" class="link">Get in touch</a>
      </div>
    </div>
  </section>

  <!-- ───────────── SELECTED WORK: one filmstrip per product ───────────── -->
  <section id="work" class="work" aria-labelledby="work-title" data-view="desktop">
    <div class="wrap work-head">
      <h2 id="work-title" data-rise>Selected work</h2>
      <div class="view-switch" role="group" aria-label="Screens" data-rise style="--i: 1">
        <button type="button" class="view-btn" data-view-btn="desktop" aria-pressed="true">Desktop</button>
        <button type="button" class="view-btn" data-view-btn="phone" aria-pressed="false">Phone</button>
      </div>
    </div>

    {
      work.map((p) => (
        <article class="project" aria-labelledby={`p-${p.slug}`}>
          <div class="film" data-film tabindex="0" aria-label={p.name}>
            {p.frames.map((f, i) => (
              <figure class={`slide slide-${f.kind}`}>
                <img
                  src={f.src}
                  alt={f.alt}
                  width={SIZE[f.kind].width}
                  height={SIZE[f.kind].height}
                  loading={i < 3 || f.kind === 'phone' ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </figure>
            ))}
          </div>

          <div class="wrap grid-12 facts" data-rise>
            <div class="f-name">
              <h3 id={`p-${p.slug}`}>{p.name}</h3>
              <p class="muted">{p.tagline}</p>
              <a href={p.caseStudy} class="link mt-6 inline-block">Read case study</a>
            </div>
            <p class="f-role">{p.role}</p>
            <p class="f-stack muted">{p.tags.join(', ')}</p>
            <p class="f-site flex flex-wrap gap-x-5">
              {p.live && <a class="link" href={p.live} target="_blank" rel="noopener noreferrer">Live</a>}
              {p.code && <a class="link" href={p.code} target="_blank" rel="noopener noreferrer">Code</a>}
            </p>
          </div>
        </article>
      ))
    }

    <div class="wrap work-cta grid-12" data-rise>
      <p class="work-cta-text">
        Building something similar? I&rsquo;m open to internships and freelance work &mdash; tell me what
        you&rsquo;re working on.
      </p>
      <div class="work-cta-actions flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href="/contact" class="btn btn-primary">Let&rsquo;s work together</a>
        <a href="/projects" class="link">All work</a>
      </div>
    </div>
  </section>

  <!-- ───────────── IN SHORT: side facts, wide paragraph, the figures ───────────── -->
  <section class="wrap section about" aria-labelledby="about-title">
    <div class="about-row">
      <div class="about-side">
        <h2 id="about-title" class="about-h" data-rise>In short</h2>
        <p class="small muted mt-2" data-rise>The person behind the commits</p>
        <dl class="mt-8 flex flex-col gap-5">
          {
            sideFacts.map((f, i) => (
              <div data-rise style={`--i: ${i + 1}`}>
                <dt class="small muted">{f.key}</dt>
                <dd class="small">{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="about-main">
        <p class="about-para" data-rise>
          I&rsquo;m Awadh Kishor Singh &mdash; I design, build, and ship end-to-end web applications with
          React, Next.js, NestJS and Node.js, with applied ML and LLM work alongside. Data Science
          undergraduate at IIT Madras, currently building my first mobile app, and a developer who
          cares about clean architecture and what users never see.
        </p>
      </div>
    </div>

    <div class="about-row mt-[120px]">
      <div class="about-side">
        <ul class="facts-list" data-rise>
          {
            restFacts.map((f) => (
              <li>
                <span>{f.value}</span>
                <span class="muted">{f.key}</span>
              </li>
            ))
          }
          <li>
            <span class="inline-flex items-center gap-2"><span class="pulse"></span>Open to internships &amp; freelance work</span>
            <span class="muted">Status</span>
          </li>
        </ul>
      </div>
      <dl class="about-main ledger-rows">
        {
          stats.map((r, i) => (
            <div class="l-row" data-rise style={`--i: ${i}`}>
              <dt class="sr-only">{r.label}</dt>
              <dd class="l-whole figures" aria-hidden="true">{r.whole}</dd>
              <dd class="l-frac figures" aria-hidden="true">{r.frac}</dd>
              <dd class="l-cap">
                <span class="sr-only">{r.whole}{r.frac} </span>
                {r.label}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ───────────── CURRENTLY BUILDING: the mobile app, beside a portrait ───────────── -->
  <section class="wrap section record grid-12" aria-labelledby="building-title">
    <div class="record-list">
      <h2 id="building-title" class="record-h" data-rise>Currently building</h2>
      <p class="small muted mt-3" data-rise>In progress</p>
      <h3 class="mt-10" data-rise>My first mobile app</h3>
      <p class="mt-4 max-w-[54ch]" data-rise>
        Alongside the web work I&rsquo;m learning Android and iOS development, taking the same
        end-to-end approach I use on the web &mdash; interface, API, data and release. The first app is
        in development, with a release planned soon.
      </p>
      <div class="mt-6 flex flex-wrap gap-2" data-rise>
        <span class="chip">Android</span>
        <span class="chip">iOS</span>
        <span class="chip">Mobile UI</span>
        <span class="chip">App release</span>
      </div>
      <ul class="mt-10" data-rise>
        <li class="row"><span>Android &amp; iOS</span><span class="row-val small muted">Platform</span></li>
        <li class="row"><span class="inline-flex items-center gap-2.5"><span class="pulse"></span>In development</span><span class="row-val small muted">Stage</span></li>
        <li class="row"><span>Planned soon</span><span class="row-val small muted">Release</span></li>
      </ul>
    </div>
    <figure class="record-photo" data-rise style="--i: 2">
      <img
        src="https://awadh-portfolio-website.s3.ap-south-1.amazonaws.com/images/sitting-image.webp"
        alt="Awadh Kishor Singh"
        width="800"
        height="1000"
        loading="lazy"
      />
    </figure>
  </section>

  <!-- ───────────── CONTACT: heading, portrait, two links ───────────── -->
  <section class="wrap section contact grid-12" aria-labelledby="contact-title">
    <h2 id="contact-title" class="contact-line" data-rise>Got a project or a role in mind?</h2>
    <figure class="contact-photo" data-rise style="--i: 1">
      <img
        src="https://awadh-portfolio-website.s3.ap-south-1.amazonaws.com/images/awadh-about.webp"
        alt="Portrait of Awadh Kishor Singh"
        width="320"
        height="320"
        loading="lazy"
      />
    </figure>
    <div class="contact-links" data-rise style="--i: 2">
      <p>
        I&rsquo;m open to software engineering, full-stack and AI/ML roles, and to internship and
        freelance opportunities.
      </p>
      <ul class="mt-5 flex flex-col gap-2">
        <li><a class="link lead" href="/contact">Say hello</a></li>
        <li><a class="link lead" href={resumeUrl} target="_blank" rel="noopener noreferrer">Résumé</a></li>
      </ul>
      <p class="small muted mt-5">The fastest way to reach me is email &mdash; I usually reply within a day.</p>
    </div>
  </section>
</PageLayout>

<style>
  /* ── HERO ── */
  .hero {
    display: flex;
    flex-direction: column;
    overflow-x: clip;
    min-height: calc(100svh - 4rem);
    padding-top: clamp(1.5rem, 1rem + 2vw, 3rem);
    padding-bottom: 2.5rem;
  }
  .hero-name {
    font-size: var(--step-display);
    line-height: 0.88;
    letter-spacing: -0.03em;
    margin-left: -0.04em;
  }
  .hero-notes {
    margin-top: clamp(1.25rem, 1rem + 1vw, 2rem);
    row-gap: 0.75rem;
  }
  .hero-notes p {
    font-size: var(--step-small);
  }
  .note-1 {
    grid-column: 1 / span 3;
  }
  .note-2 {
    grid-column: 4 / span 3;
  }
  .note-3 {
    grid-column: 7 / span 3;
  }
  .note-4 {
    grid-column: 10 / span 3;
  }

  /* A row of frames wider than the screen. The frame nearest the centre is lit. */
  .strip {
    display: flex;
    gap: 10px;
    height: 34svh;
    min-height: 220px;
    margin-top: auto;
    margin-bottom: auto;
    padding: clamp(1.5rem, 1rem + 2vw, 3rem) 0;
    box-sizing: content-box;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .strip::-webkit-scrollbar {
    display: none;
  }
  .frame {
    position: relative;
    flex: none;
    height: 100%;
    scroll-snap-align: center;
  }
  .frame img {
    height: 100%;
    width: auto;
    object-fit: cover;
    transition:
      filter 0.5s var(--ease-out),
      transform 0.6s var(--ease-out);
  }
  /* The title of the lit frame, kept inside the page margins. */
  .strip-title {
    width: fit-content;
    margin-top: calc(-1 * clamp(1.5rem, 1rem + 2vw, 3rem) + 0.6rem);
    margin-bottom: clamp(1.5rem, 1rem + 2vw, 3rem);
    padding-left: var(--margin);
    transform: translateX(var(--title-x, 0px));
    transition: transform 0.45s var(--ease-out);
  }
  :global(.js) .frame:not(.is-lit) img {
    filter: brightness(0.5);
  }
  :global(.js) .frame:hover img {
    filter: none;
  }
  .frame.is-lit img {
    transform: scale(1.015);
  }

  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }

  /* ── WORK ── */
  .work {
    padding-top: calc(var(--section-gap) / 2);
  }
  .work-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 1.5rem 3rem;
    margin-bottom: clamp(3rem, 2rem + 3vw, 6rem);
  }
  .view-switch {
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    background: var(--surface);
  }
  .view-btn {
    min-height: 44px;
    padding: 0 1.1rem;
    font: inherit;
    font-size: var(--step-small);
    font-weight: 500;
    color: var(--muted);
    background: transparent;
    border: 0;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .view-btn:hover {
    color: var(--ink);
  }
  .view-btn[aria-pressed='true'] {
    background: var(--ink);
    color: var(--bg);
  }

  .project + .project {
    margin-top: clamp(4rem, 2rem + 8vw, 10rem);
  }
  /* The filmstrip: a centred slide with its neighbours cut by the screen edges. */
  .film {
    --slide-w: 73vw;
    --slide-h: calc(var(--slide-w) * 600 / 1046);
    display: flex;
    gap: 20px;
    padding-inline: calc((100vw - var(--slide-w)) / 2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    cursor: grab;
  }
  .film::-webkit-scrollbar {
    display: none;
  }
  .film.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }
  .film.is-dragging img {
    pointer-events: none;
  }
  .slide {
    flex: none;
    height: var(--slide-h);
    scroll-snap-align: center;
    background: var(--surface);
    overflow: hidden;
  }
  .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    user-select: none;
    -webkit-user-drag: none;
  }
  .slide-desktop {
    width: var(--slide-w);
  }
  .slide-phone {
    width: calc(var(--slide-h) * 390 / 844);
  }
  .work[data-view='desktop'] .slide-phone,
  .work[data-view='phone'] .slide-desktop {
    display: none;
  }

  .facts {
    margin-top: 26px;
    row-gap: 0.5rem;
  }
  .facts h3 {
    font-size: var(--step-body);
    font-weight: 500;
    line-height: 1.45;
  }
  .work-cta {
    margin-top: clamp(4rem, 2rem + 6vw, 8rem);
    row-gap: 1.5rem;
    align-items: end;
  }
  .work-cta-text {
    grid-column: 1 / span 6;
    font-size: var(--step-lead);
    line-height: 1.3;
  }
  .work-cta-actions {
    grid-column: 8 / span 5;
  }
  .facts-list li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 6px 0;
    font-size: var(--step-small);
  }
  .about .ledger-rows {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .f-name {
    grid-column: 1 / span 3;
  }
  .f-role {
    grid-column: 4 / span 3;
  }
  .f-stack {
    grid-column: 7 / span 3;
  }
  .f-site {
    grid-column: 10 / span 3;
    justify-self: start;
    align-self: start;
  }

  /* ── SECTIONS ── */
  .section {
    margin-top: var(--section-gap);
  }

  /* ── ABOUT ── */
  .about-row {
    display: grid;
    grid-template-columns: 34% minmax(0, 56%);
    column-gap: 0;
  }
  .about-side {
    padding-right: 2rem;
  }
  .about-side dl {
    max-width: 160px;
  }
  .about-h {
    font-size: var(--step-lead);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .about-para {
    font-size: var(--step-lead);
    line-height: 1.35;
  }
  .stack-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 260px));
    column-gap: 64px;
    row-gap: 2.5rem;
  }
  .stack-list li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 5px 0;
    font-size: var(--step-small);
  }

  /* ── RECORD ── */
  .record {
    align-items: start;
  }
  .record-list {
    grid-column: 3 / span 5;
  }
  .record-h {
    font-size: var(--step-head);
  }
  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 38px;
    padding: 6px 0;
  }
  .row-name {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
  }
  .dot {
    flex: none;
    width: 12px;
    height: 12px;
    border-radius: 99px;
    transform: translateY(1px);
  }
  .row-val {
    flex: none;
    text-align: right;
  }
  .record-photo {
    grid-column: 9 / span 4;
    position: sticky;
    top: 6rem;
    overflow: hidden;
    background: var(--surface);
  }
  .record-photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  /* ── LEDGER ── */
  .ledger {
    align-items: center;
  }
  .ledger-h {
    grid-column: 1 / span 4;
    font-size: var(--step-head);
    line-height: 1;
  }
  .ledger-rows {
    grid-column: 5 / span 8;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .l-row {
    display: grid;
    grid-template-columns: 3.3em 1.3em minmax(0, 1fr);
    align-items: baseline;
    column-gap: 0;
    font-size: var(--step-display);
  }
  .l-whole,
  .l-frac {
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .l-whole {
    text-align: right;
  }
  .l-cap {
    padding-left: 1.25rem;
    font-size: var(--step-body);
    line-height: 1.35;
    max-width: 30ch;
  }

  /* ── CONTACT ── */
  .contact {
    align-items: start;
  }
  .contact-line {
    grid-column: 1 / span 5;
    font-size: var(--step-head);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .contact-photo {
    grid-column: 8 / span 2;
    width: 160px;
    max-width: 100%;
  }
  .contact-photo img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center 20%;
  }
  .contact-links {
    grid-column: 10 / span 3;
  }

  /* ── PHONE AND TABLET ── */
  @media (max-width: 899px) {
    .note-1,
    .note-2,
    .note-3,
    .note-4 {
      grid-column: span 6;
    }
    .strip {
      height: 46svh;
    }
    .film {
      --slide-w: 78vw;
      --slide-h: calc(var(--slide-w) * 5 / 4);
      gap: 10px;
    }
    .slide-desktop img {
      object-position: left top;
    }
    .f-name {
      grid-column: 1 / span 6;
    }
    .f-role,
    .f-stack,
    .f-site {
      grid-column: 7 / span 6;
    }
    .f-role {
      grid-row: 1;
    }
    .f-stack {
      grid-row: 2;
    }
    .f-site {
      grid-row: 3;
    }
    .about-row {
      grid-template-columns: 1fr;
      row-gap: 2rem;
    }
    /* The facts list and the figures are two blocks, not a label above a number. */
    .about .ledger-rows {
      order: -1;
      margin-bottom: 2.5rem;
    }
    .about-side dl {
      max-width: none;
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .stack-cols {
      grid-template-columns: 1fr;
    }
    .record-list {
      grid-column: 1 / -1;
    }
    .record-photo {
      grid-column: 1 / -1;
      position: static;
      margin-top: 3rem;
    }
    .ledger-h,
    .ledger-rows {
      grid-column: 1 / -1;
    }
    .ledger-rows {
      margin-top: 2.5rem;
      gap: 28px;
    }
    .work-cta-text,
    .work-cta-actions {
      grid-column: 1 / -1;
    }
    .l-row {
      grid-template-columns: 3.3em 1.3em;
      font-size: 15vw;
    }
    .l-cap {
      grid-column: 1 / -1;
      padding: 0.4rem 0 0;
      font-size: var(--step-small);
    }
    .contact-line {
      grid-column: 1 / -1;
    }
    .contact-photo {
      grid-column: 1 / span 4;
      width: 96px;
      margin-top: 2rem;
    }
    .contact-links {
      grid-column: 5 / span 8;
      margin-top: 2rem;
    }
  }
  @media (max-width: 559px) {
    .note-1,
    .note-2,
    .note-3,
    .note-4 {
      grid-column: 1 / -1;
    }
    .hero-notes p.note-2 {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .frame img,
    .strip-title {
      transition: none;
    }
    .frame.is-lit img {
      transform: none;
    }
  }
</style>

<script>
  // Hero strip: light the frame nearest the middle, and open on the third frame.
  const strip = document.querySelector<HTMLElement>('[data-strip]');
  if (strip) {
    const frames = [...strip.querySelectorAll<HTMLElement>('[data-frame]')];
    const title = document.querySelector<HTMLElement>('[data-strip-title]');
    const light = () => {
      const mid = strip.scrollLeft + strip.clientWidth / 2;
      let best = frames[0];
      let dist = Infinity;
      for (const f of frames) {
        const d = Math.abs(f.offsetLeft + f.offsetWidth / 2 - mid);
        if (d < dist) {
          dist = d;
          best = f;
        }
      }
      frames.forEach((f) => f.classList.toggle('is-lit', f === best));
      if (title && best) {
        title.textContent = best.dataset.name ?? '';
        // Align the title to the lit frame's left edge, never outside the page margins.
        const margin = parseFloat(getComputedStyle(title).paddingLeft) || 0;
        const left = best.offsetLeft - strip.scrollLeft;
        const max = strip.clientWidth - margin - 240;
        title.style.setProperty('--title-x', `${Math.max(0, Math.min(left - margin, max))}px`);
      }
    };
    const start = frames[2];
    if (start) strip.scrollLeft = start.offsetLeft + start.offsetWidth / 2 - strip.clientWidth / 2;
    light();
    let raf = 0;
    strip.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(light);
      },
      { passive: true }
    );
  }

  // Filmstrips: open on the second slide so a neighbour shows on each side,
  // and let a mouse drag them sideways the way a touch screen does.
  const films = document.querySelectorAll<HTMLElement>('[data-film]');
  const centre = (film: HTMLElement) => {
    const visible = [...film.children].filter((c) => (c as HTMLElement).offsetWidth > 0) as HTMLElement[];
    const target = visible[1] ?? visible[0];
    if (target) film.scrollLeft = target.offsetLeft + target.offsetWidth / 2 - film.clientWidth / 2;
  };
  films.forEach((film) => {
    centre(film);
    let down = false;
    let startX = 0;
    let startLeft = 0;
    film.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return;
      down = true;
      startX = e.clientX;
      startLeft = film.scrollLeft;
      film.classList.add('is-dragging');
      film.setPointerCapture(e.pointerId);
    });
    film.addEventListener('pointermove', (e) => {
      if (down) film.scrollLeft = startLeft - (e.clientX - startX);
    });
    const end = () => {
      if (!down) return;
      down = false;
      film.classList.remove('is-dragging');
    };
    film.addEventListener('pointerup', end);
    film.addEventListener('pointercancel', end);
  });

  // The Desktop / Phone switch swaps every filmstrip between the two captures.
  // Phones open on the phone captures, which fit their portrait slides.
  const work = document.querySelector<HTMLElement>('.work');
  const viewBtns = document.querySelectorAll<HTMLButtonElement>('[data-view-btn]');
  const setView = (view: string) => {
    if (!work) return;
    work.dataset.view = view;
    viewBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.viewBtn === view)));
    films.forEach(centre);
  };
  viewBtns.forEach((btn) => btn.addEventListener('click', () => setView(btn.dataset.viewBtn!)));
  if (window.matchMedia('(max-width: 899px)').matches) setView('phone');
</script>
