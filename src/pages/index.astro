---
import PageLayout from '../layouts/PageLayout.astro';
import { projects, featuredProjects } from '../data/projects';
import { shots, SIZE } from '../data/shots';
import { socials } from '../utils/socials';
import { resumeUrl } from '../utils/site';

// One desktop screen and one phone screen per product, composed as a plate.
const work = featuredProjects.map((p) => {
  const frames = shots[p.slug] ?? [];
  return {
    ...p,
    desktop: frames.find((f) => f.kind === 'desktop'),
    phone: frames.find((f) => f.kind === 'phone'),
  };
});

const stats = [
  { whole: '1,000+', frac: '', label: 'DSA problems solved' },
  { whole: '2,100+', frac: '', label: 'GitHub commits' },
  { whole: '6', frac: '', label: 'Products shipped' },
  { whole: '8', frac: '.27', label: 'CGPA · IIT Madras' },
];

const profile = [
  { key: 'Name', value: 'Awadh Kishor Singh' },
  { key: 'Alias', value: 'imawadh · im_awadh_' },
  { key: 'Role', value: 'Full Stack AI Developer' },
  { key: 'Education', value: 'BS Data Science, IIT Madras' },
  { key: 'Based', value: 'Bengaluru, India · Remote-friendly' },
  { key: 'Stack', value: 'React · Next.js · NestJS · Node.js · PostgreSQL · AWS' },
  { key: 'Recently', value: 'Full Stack Developer Intern, IAVerse' },
  { key: 'Learning', value: 'Android & iOS — first app releasing soon' },
];
const sideKeys = ['Role', 'Education', 'Based'];
const sideFacts = profile.filter((f) => sideKeys.includes(f.key));
const restFacts = profile.filter((f) => !sideKeys.includes(f.key));
---

<PageLayout
  title="Awadh Kishor Singh | Full Stack AI Developer"
  description="Awadh Kishor Singh — Full Stack AI Developer in Bengaluru building production-ready web apps with React, Next.js, NestJS and Node.js, with applied ML and LLM experience. Data Science undergraduate at IIT Madras, open to internships and freelance work."
>
  <!-- ───────────── HERO: the name, one sentence, where to find me ───────────── -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <img
        class="hero-avatar reveal reveal-1"
        src="https://awadh-portfolio-website.s3.ap-south-1.amazonaws.com/images/awadh-about.webp"
        alt="Portrait of Awadh Kishor Singh"
        width="96"
        height="96"
        fetchpriority="high"
      />
      <h1 id="hero-title" class="hero-name reveal reveal-1">Awadh Kishor Singh</h1>

      <div class="hero-row grid-12 reveal reveal-2">
        <p class="lead hero-lead">Full Stack AI Developer building production-ready web apps.</p>

        <div class="hero-side">
          <p class="small inline-flex items-start gap-2.5">
            <span class="pulse mt-[0.45em]"></span>Open to internships &amp; freelance work
          </p>
          <p class="small muted">BS Data Science, IIT Madras. Bengaluru, India · Remote-friendly</p>
          <p class="small flex flex-wrap gap-x-4">
            {
              socials.map((s) => (
                <a class="link" href={s.url} target="_blank" rel="noopener noreferrer">
                  {s.label}
                </a>
              ))
            }
          </p>
        </div>
      </div>

      <div class="hero-actions flex flex-wrap items-center gap-x-3 gap-y-3 reveal reveal-3">
        <a href="/projects" class="btn btn-primary">View work</a>
        <a href={resumeUrl} target="_blank" rel="noopener noreferrer" class="btn">Résumé</a>
        <a href="/contact" class="btn btn-ghost">Get in touch</a>
      </div>
    </div>
  </section>

  <!-- ───────────── SELECTED WORK: one plate per product ───────────── -->
  <section id="work" class="work" aria-labelledby="work-title">
    <div class="wrap work-head">
      <h2 id="work-title" data-rise>Selected work</h2>
      <a href="/projects" class="link small" data-rise style="--i: 1">All work</a>
    </div>

    {
      work.map((p) => (
        <article class="project wrap" aria-labelledby={`p-${p.slug}`}>
          <div class="project-card">
          {p.desktop && (
            <a class="shot" href={p.caseStudy} aria-label={`${p.name}: read the case study`} data-rise>
              <span class="shot-desktop">
                <img
                  src={p.desktop.src}
                  alt={p.desktop.alt}
                  width={SIZE.desktop.width}
                  height={SIZE.desktop.height}
                  loading="lazy"
                  decoding="async"
                />
              </span>
              {p.phone && (
                <span class="shot-phone">
                  <img
                    src={p.phone.src}
                    alt={p.phone.alt}
                    width={SIZE.phone.width}
                    height={SIZE.phone.height}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              )}
            </a>
          )}

          <div class="grid-12 facts" data-rise>
            <div class="f-name">
              <h3 id={`p-${p.slug}`}>{p.name}</h3>
              <p class="muted">{p.tagline}</p>
              <a href={p.caseStudy} class="link small mt-5 inline-block">Read case study</a>
            </div>
            <p class="f-role small">{p.role}</p>
            <p class="f-stack small muted">{p.tags.join(', ')}</p>
            <p class="f-site small flex flex-wrap gap-x-5">
              {p.live && <a class="link" href={p.live} target="_blank" rel="noopener noreferrer">Live</a>}
              {p.code && <a class="link" href={p.code} target="_blank" rel="noopener noreferrer">Code</a>}
            </p>
          </div>
          </div>
        </article>
      ))
    }

    <div class="wrap work-cta grid-12" data-rise>
      <p class="work-cta-text">
        Building something similar? I&rsquo;m open to internships and freelance work &mdash; tell me what
        you&rsquo;re working on.
      </p>
      <div class="work-cta-actions flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href="/contact" class="btn btn-primary">Let&rsquo;s work together</a>
        <a href="/projects" class="link">All work</a>
      </div>
    </div>
  </section>

  <!-- ───────────── IN SHORT: who, in one paragraph and four figures ───────────── -->
  <section class="wrap section about grid-12" aria-labelledby="about-title">
    <div class="about-side">
      <h2 id="about-title" class="about-h" data-rise>In short</h2>
      <p class="small muted mt-2" data-rise>The person behind the commits</p>
      <dl class="mt-8 flex flex-col gap-5">
        {
          sideFacts.map((f, i) => (
            <div data-rise style={`--i: ${i + 1}`}>
              <dt class="small muted">{f.key}</dt>
              <dd class="small">{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="about-main">
      <p class="about-para" data-rise>
        I&rsquo;m Awadh Kishor Singh &mdash; I design, build, and ship end-to-end web applications with
        React, Next.js, NestJS and Node.js, with applied ML and LLM work alongside. Data Science
        undergraduate at IIT Madras, currently building my first mobile app, and a developer who
        cares about clean architecture and what users never see.
      </p>

      <dl class="stats" data-rise>
        {
          stats.map((r) => (
            <div class="stat">
              <dt class="sr-only">{r.label}</dt>
              <dd class="stat-num figures" aria-hidden="true">{r.whole}{r.frac}</dd>
              <dd class="stat-cap small muted">
                <span class="sr-only">{r.whole}{r.frac} </span>
                {r.label}
              </dd>
            </div>
          ))
        }
      </dl>

      <ul class="facts-list" data-rise>
        {
          restFacts.map((f) => (
            <li>
              <span class="muted">{f.key}</span>
              <span>{f.value}</span>
            </li>
          ))
        }
        <li>
          <span class="muted">Status</span>
          <span class="inline-flex items-center gap-2"><span class="pulse"></span>Open to internships &amp; freelance work</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ───────────── CURRENTLY BUILDING: the mobile app, beside a portrait ───────────── -->
  <section class="wrap section record grid-12" aria-labelledby="building-title">
    <div class="record-list">
      <h2 id="building-title" class="record-h" data-rise>Currently building</h2>
      <p class="small muted mt-3" data-rise>In progress</p>
      <h3 class="mt-10" data-rise>My first mobile app</h3>
      <p class="mt-4 max-w-[54ch]" data-rise>
        Alongside the web work I&rsquo;m learning Android and iOS development, taking the same
        end-to-end approach I use on the web &mdash; interface, API, data and release. The first app is
        in development, with a release planned soon.
      </p>
      <div class="mt-6 flex flex-wrap gap-2" data-rise>
        <span class="chip">Android</span>
        <span class="chip">iOS</span>
        <span class="chip">Mobile UI</span>
        <span class="chip">App release</span>
      </div>
      <ul class="mt-10 facts-list" data-rise>
        <li><span class="muted">Platform</span><span>Android &amp; iOS</span></li>
        <li><span class="muted">Stage</span><span class="inline-flex items-center gap-2.5"><span class="pulse"></span>In development</span></li>
        <li><span class="muted">Release</span><span>Planned soon</span></li>
      </ul>
    </div>
    <figure class="record-photo" data-rise style="--i: 2">
      <img
        src="https://awadh-portfolio-website.s3.ap-south-1.amazonaws.com/images/sitting-image.webp"
        alt="Awadh Kishor Singh"
        width="800"
        height="1000"
        loading="lazy"
      />
    </figure>
  </section>

  <!-- ───────────── CONTACT ───────────── -->
  <section class="wrap section contact grid-12" aria-labelledby="contact-title">
    <h2 id="contact-title" class="contact-line" data-rise>Got a project or a role in mind?</h2>
    <div class="contact-side" data-rise style="--i: 1">
      <figure class="contact-photo">
        <img
          src="https://awadh-portfolio-website.s3.ap-south-1.amazonaws.com/images/awadh-about.webp"
          alt="Portrait of Awadh Kishor Singh"
          width="320"
          height="320"
          loading="lazy"
        />
      </figure>
      <p class="mt-6">
        I&rsquo;m open to software engineering, full-stack and AI/ML roles, and to internship and
        freelance opportunities.
      </p>
      <ul class="mt-5 flex flex-col gap-2">
        <li><a class="link lead" href="/contact">Say hello</a></li>
        <li><a class="link lead" href={resumeUrl} target="_blank" rel="noopener noreferrer">Résumé</a></li>
      </ul>
      <p class="small muted mt-5">The fastest way to reach me is email &mdash; I usually reply within a day.</p>
    </div>
  </section>
</PageLayout>

<style>
  /* ── HERO ── */
  .hero {
    padding-top: clamp(2.5rem, 1.5rem + 5vw, 6.5rem);
    padding-bottom: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }
  .hero-avatar {
    width: 96px;
    height: 96px;
    margin-bottom: 1.5rem;
    border-radius: 9999px;
    object-fit: cover;
    object-position: center 20%;
    background: var(--surface);
    box-shadow: var(--shadow-2);
  }
  .hero-name {
    max-width: 14ch;
  }
  .hero-row {
    margin-top: clamp(2rem, 1.5rem + 2.5vw, 4rem);
    row-gap: 1.5rem;
    align-items: start;
  }
  .hero-lead {
    grid-column: 1 / span 6;
    max-width: 24ch;
  }
  .hero-side {
    grid-column: 8 / span 5;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .hero-side p {
    max-width: 44ch;
  }
  .hero-actions {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }

  /* ── WORK ── */
  .work-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(1.75rem, 1.25rem + 2vw, 3rem);
  }

  .project + .project {
    margin-top: clamp(1.5rem, 1rem + 2vw, 2.75rem);
  }
  .project-card {
    padding: clamp(0.75rem, 0.5rem + 1vw, 1.375rem);
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow-1);
  }
  .project-card .facts {
    padding: 0 clamp(0.25rem, 0.1rem + 0.8vw, 0.75rem) clamp(0.25rem, 0.1rem + 0.8vw, 0.75rem);
  }

  /* A plate: the desktop screen and a phone screen, resting on a tinted ground. */
  .shot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(5.5rem, 17vw, 16.5rem);
    align-items: end;
    gap: clamp(0.75rem, 0.4rem + 1.6vw, 1.75rem);
    padding: clamp(0.9rem, 0.4rem + 2.8vw, 2.75rem);
    background: var(--surface-2);
    border-radius: var(--radius-sm);
  }
  .shot-desktop,
  .shot-phone {
    display: block;
    overflow: hidden;
    border-radius: 6px;
    background: var(--surface);
    box-shadow: var(--shadow-2);
  }
  .shot img {
    width: 100%;
    height: auto;
    object-fit: cover;
    object-position: top center;
  }
  .shot-desktop img {
    aspect-ratio: 1440 / 900;
  }
  .shot-phone img {
    aspect-ratio: 390 / 844;
  }

  .facts {
    margin-top: clamp(1.25rem, 1rem + 1vw, 2rem);
    row-gap: 0.75rem;
  }
  .facts h3 {
    margin-bottom: 0.4rem;
  }
  .f-name {
    grid-column: 1 / span 5;
  }
  .f-role {
    grid-column: 7 / span 2;
  }
  .f-stack {
    grid-column: 9 / span 2;
  }
  .f-site {
    grid-column: 11 / span 2;
    justify-self: start;
    align-self: start;
  }

  .work-cta {
    margin-top: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    row-gap: 1.5rem;
    align-items: center;
  }
  .work-cta-text {
    grid-column: 1 / span 7;
    font-family: var(--font-display);
    font-size: var(--step-title);
    line-height: 1.2;
    color: var(--ink);
    max-width: 32ch;
  }
  .work-cta {
    width: calc(100% - 2 * var(--margin));
    max-width: 1120px;
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    background: var(--surface);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-1);
  }
  .work-cta-actions {
    grid-column: 9 / span 4;
  }

  /* ── SECTIONS ── */
  .section {
    margin-top: var(--section-gap);
  }

  /* ── ABOUT ── */
  .about {
    row-gap: 3rem;
  }
  .about-side {
    grid-column: 1 / span 4;
  }
  .about-side dl {
    max-width: 200px;
  }
  .about-h {
    font-size: var(--step-head);
  }
  .about-main {
    grid-column: 6 / span 7;
  }
  .about-para {
    font-size: var(--step-lead);
    line-height: 1.35;
    max-width: 34em;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem clamp(1rem, 0.5rem + 1.6vw, 2rem);
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
  }
  .stat {
    padding: 1.125rem 1rem;
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow-1);
  }
  .stat-num {
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 1.2rem + 1vw, 2.125rem);
    font-weight: 400;
    color: var(--ink);
    line-height: 1;
    font-variant-numeric: lining-nums proportional-nums;
  }
  .stat-cap {
    margin-top: 0.6rem;
    max-width: 16ch;
  }

  .facts-list {
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }
  .facts-list li {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    align-items: baseline;
    gap: 1rem;
    padding: 0.8rem 0;
    font-size: var(--step-small);
    color: var(--ink);
    box-shadow: 0 -1px 0 var(--line);
  }
  .facts-list li:last-child {
    box-shadow:
      0 -1px 0 var(--line),
      0 1px 0 var(--line);
  }

  /* ── RECORD ── */
  .record {
    align-items: start;
  }
  .record-list {
    grid-column: 1 / span 6;
  }
  .record-h {
    font-size: var(--step-head);
  }
  .record-photo {
    grid-column: 8 / span 5;
    overflow: hidden;
    background: var(--surface);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-1);
  }
  .record-photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  /* ── CONTACT ── */
  .contact {
    align-items: start;
    row-gap: 2.5rem;
  }
  .contact-line {
    grid-column: 1 / span 7;
    font-size: var(--step-display);
    letter-spacing: -0.011em;
    line-height: 1.02;
  }
  .contact-side {
    grid-column: 9 / span 4;
  }
  .contact-photo {
    width: 96px;
    overflow: hidden;
    border-radius: 9999px;
    box-shadow: var(--shadow-2);
  }
  .contact-photo img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center 20%;
  }

  /* ── PHONE AND TABLET ── */
  @media (max-width: 899px) {
    .hero-lead,
    .hero-side {
      grid-column: 1 / -1;
    }
    .f-name {
      grid-column: 1 / -1;
    }
    .f-role {
      grid-column: 1 / span 4;
    }
    .f-stack {
      grid-column: 5 / span 4;
    }
    .f-site {
      grid-column: 9 / span 4;
    }
    .work-cta-text,
    .work-cta-actions {
      grid-column: 1 / -1;
    }
    .about-side,
    .about-main {
      grid-column: 1 / -1;
    }
    .about-side dl {
      max-width: none;
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .record-list,
    .record-photo {
      grid-column: 1 / -1;
    }
    .record-photo {
      margin-top: 3rem;
    }
    .contact-line,
    .contact-side {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 559px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .facts-list li {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
    .f-role,
    .f-stack,
    .f-site {
      grid-column: 1 / -1;
    }
  }
</style>
