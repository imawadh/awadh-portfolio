---
import PageLayout from '../layouts/PageLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { socials } from '../utils/socials';
import { featuredProjects } from '../data/projects';
import { resumeUrl } from '../utils/site';

const facts = [
  { key: 'Based in', value: 'Bengaluru, India. Happy to work remotely.' },
  { key: 'Studying', value: 'BS in Data Science, IIT Madras (CGPA 8.27)' },
  { key: 'Most recently', value: 'Full Stack Developer Intern at IAVerse' },
  { key: 'Works with', value: 'React, Next.js, NestJS, Node.js, PostgreSQL, AWS' },
  { key: 'Practice', value: '1,000+ DSA problems solved, 2,100+ GitHub commits' },
];
---

<PageLayout
  title="Awadh Kishor Singh | Full Stack AI Developer"
  description="Awadh Kishor Singh — Full Stack AI Developer in Bengaluru building production-ready web apps with React, Next.js, NestJS and Node.js, with applied ML and LLM experience. Data Science undergraduate at IIT Madras, open to internships and freelance work."
>
  <!-- ───────────── HERO ───────────── -->
  <section class="wrap band-lead pb-16 md:pb-24">
    <h1 class="hero-name" aria-label="Awadh Kishor Singh">
      <span class="hero-line"><span style="--d: 0s">Awadh</span></span>
      <span class="hero-line hero-line-2">
        <span style="--d: 0.09s">Kishor Singh</span>
        <figure class="hero-portrait" style="--d: 0.25s">
          <img
            src="https://awadh-portfolio-website.s3.ap-south-1.amazonaws.com/images/awadh-about.webp"
            alt=""
            loading="eager"
            width="640"
            height="800"
          />
        </figure>
      </span>
    </h1>

    <div class="hero-foot mt-10 grid gap-10 md:mt-14 md:grid-cols-[7fr_5fr] md:gap-16">
      <div>
        <p class="hero-lede m-0 max-w-[34ch]">
          I build web apps end to end, from the interface to the API, the database and the deploy,
          and train the ML models some of them run on.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/projects" class="btn btn-primary">See my work</a>
          <a href={resumeUrl} target="_blank" rel="noopener noreferrer" class="btn">Download résumé</a>
        </div>
      </div>

      <div class="ui flex flex-col gap-4 md:pt-2">
        <p class="ui m-0 inline-flex items-center gap-2.5 text-[1.05rem] text-[var(--fg)]">
          <span class="pulse"></span>
          Open to internships and freelance work
        </p>
        <p class="m-0 text-[1rem] text-[var(--muted)]">
          Full Stack AI Developer in Bengaluru, studying Data Science at IIT Madras.
        </p>
        <div class="flex flex-wrap gap-2">
          {
            socials.map((social) => (
              <a href={social.url} target="_blank" rel="noopener noreferrer" class="chip">
                {social.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────── SELECTED WORK ───────────── -->
  <section class="wrap band band-b">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="m-0">Selected work</h2>
        <p class="m-0 mt-3 max-w-[48ch] text-[var(--muted)]">
          Products I built and shipped, for clients and for myself.
        </p>
      </div>
      <a href="/projects" class="link ui text-[1.02rem] font-semibold">See all projects</a>
    </div>

    <div class="mt-10 border-b border-[var(--border-bright)]">
      {
        featuredProjects.map((p) => (
          <ProjectCard
            name={p.name}
            tagline={p.tagline}
            role={p.role}
            description={p.description}
            tags={p.tags}
            status={p.status}
            live={p.live}
            code={p.code}
            caseStudy={p.caseStudy}
          />
        ))
      }
    </div>

    <div class="mt-12 flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
      <p class="m-0 max-w-[48ch]">
        Building something similar? Tell me what you&rsquo;re working on.
      </p>
      <a href="/contact" class="btn btn-primary shrink-0">Start a conversation</a>
    </div>
  </section>

  <!-- ───────────── ABOUT, IN SHORT ───────────── -->
  <section class="wrap band band-a">
    <div class="split">
      <div class="split-head">
        <h2 class="m-0">In short</h2>
        <p>The background behind the work.</p>
      </div>

      <div>
        <p class="m-0 max-w-[60ch] text-[1.2rem] leading-[1.65] text-[var(--fg)]">
          I&rsquo;ve shipped production apps across internships and freelance work: a 1,200-page
          WordPress-to-Next.js migration, an ML scoring engine for a workforce platform, and an
          ed-tech site serving 1,500+ students a day. I care about clean architecture and the parts
          of a product users never see.
        </p>

        <dl class="mt-10 border-t border-[var(--border-bright)]">
          {
            facts.map((f) => (
              <div class="grid gap-1 border-b border-[var(--border)] py-4 sm:grid-cols-[10rem_1fr] sm:gap-6">
                <dt class="ui text-[1rem] font-semibold text-[var(--fg)]">{f.key}</dt>
                <dd class="serif m-0 text-[1.05rem] text-[var(--fg-dim)]">
                  {f.value}
                </dd>
              </div>
            ))
          }
        </dl>

        <a href="/about" class="link ui mt-8 inline-block text-[1.02rem] font-semibold">More about me</a>
      </div>
    </div>
  </section>

  <!-- ───────────── RIGHT NOW ───────────── -->
  <section class="wrap band band-b">
    <div class="split">
      <div class="split-head">
        <h2 class="m-0">Right now</h2>
        <p>What I&rsquo;m working on outside client work.</p>
      </div>

      <div class="now-card card p-7 md:p-10">
        <p class="ui m-0 inline-flex items-center gap-2.5 text-[1rem] text-[var(--signal)]">
          <span class="pulse"></span>
          In development, releasing soon
        </p>
        <h3 class="mt-4 text-[2rem] md:text-[2.6rem]">My first mobile app</h3>
        <p class="m-0 mt-4 max-w-[56ch]">
          I&rsquo;m learning Android and iOS development and taking the same end-to-end approach I
          use on the web: interface, API, data and release.
        </p>
        <div class="mt-6 flex flex-wrap gap-1.5">
          <span class="chip">Android</span>
          <span class="chip">iOS</span>
          <span class="chip">Mobile UI</span>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  /* The name is the hero: condensed, enormous, rising out of its line masks. */
  .hero-name {
    font-size: clamp(4.2rem, 17.5vw, 15rem);
    font-weight: 750;
    font-variation-settings: 'wdth' 75;
    letter-spacing: -0.028em;
    line-height: 0.84;
    margin-left: -0.04em;
  }
  .hero-line {
    display: flex;
    align-items: flex-end;
    gap: 0.12em;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .hero-line > span {
    display: block;
    animation: rise 0.95s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--d);
  }
  .hero-portrait {
    flex-shrink: 0;
    width: 0.72em;
    height: 0.84em;
    margin: 0 0 0.05em auto;
    border-radius: 0.11em;
    overflow: hidden;
    background: var(--bg-2);
    animation: settle 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--d);
  }
  .hero-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }
  /* Narrow screens: the portrait would crowd the second line, so it drops. */
  @media (max-width: 639px) {
    .hero-portrait {
      display: none;
    }
  }

  .hero-lede {
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    line-height: 1.4;
    color: var(--fg);
  }
  .hero-foot {
    animation: fade 0.8s ease both;
    animation-delay: 0.45s;
  }

  @keyframes rise {
    from {
      transform: translateY(105%);
    }
    to {
      transform: translateY(0);
    }
  }
  @keyframes settle {
    from {
      opacity: 0;
      transform: scale(0.92);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-line > span,
    .hero-portrait,
    .hero-foot {
      animation: none;
    }
  }
</style>
